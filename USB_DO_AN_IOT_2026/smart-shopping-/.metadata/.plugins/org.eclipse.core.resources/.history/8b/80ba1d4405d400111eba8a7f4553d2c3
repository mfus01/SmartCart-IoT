export function clearProductHighlight() {

    highlightedProduct = null;

    drawSupermarketMap();

}


// ============================================================
// 27. XOA LO TRINH
// ============================================================

export function clearRoute() {

    currentRoute = null;

    drawSupermarketMap();

}


// ============================================================
// 28. LAY DANH SACH KE
// ============================================================

export function getMapShelves() {

    return shelves.map(shelf => ({

        id: shelf.id,

        label: shelf.label,

        zoneId: shelf.zoneId,

        zone: shelf.zone,

        x: shelf.x,

        y: shelf.y,

        width: shelf.width,

        height: shelf.height,

        accessX: shelf.accessX,

        accessY: shelf.accessY,

        color: shelf.color

    }));

}


// ============================================================
