// ============================================================
// 18. TIM KHU VUC
// ============================================================

function findZone(zoneId) {

    if (!zoneId) {
        return null;
    }

    const id = String(zoneId)
        .trim()
        .toUpperCase();

    return zones.find(zone => zone.id === id) || null;

}


// ============================================================
// 19. CHUAN HOA MA KE
// ============================================================

function normalizeShelfId(shelfId) {

    if (shelfId === null || shelfId === undefined) {
        return null;
    }

    const id = String(shelfId)
        .trim()
        .toUpperCase();

    if (!id) {
        return null;
    }

    // Ma ke moi: A1..H3.

    if (/^[A-H][1-3]$/.test(id)) {
        return id;
    }

    // Tuong thich tam thoi voi du lieu cu.
    //
    // Neu du lieu cu chi co A/B/C/D, cac ma nay
    // duoc hien thi o ke dau tien cua khu cung ma.
    //
    // Day KHONG thay the viec cap nhat shelf_id
    // trong SQLite theo vi tri san pham thuc te.

    if (/^[A-H]$/.test(id)) {
        return id + "1";
    }

    return id;

}


// ============================================================
// 20. TIM KE THEO MA
// ============================================================

function findShelf(shelfId) {

    const id = normalizeShelfId(shelfId);

    if (!id) {
        return null;
    }

    return shelves.find(
        shelf => shelf.id === id
    ) || null;

}


// ============================================================
// 21. VE DANH DAU SAN PHAM
// ============================================================

function drawProductHighlight(product) {
    if (!product) {
        return;
    }

    const shelf = findShelf(product.shelfId);

    let px;
    let py;

    if (shelf) {
        px = toCanvasX(shelf.accessX);
        py = toCanvasY(shelf.accessY);
    } else {
        const x = Number(product.xCoord);
        const y = Number(product.yCoord);

        if (
            !Number.isFinite(x) ||
            !Number.isFinite(y) ||
            x < 0 ||
            x > MAP_WIDTH ||
            y < 0 ||
            y > MAP_HEIGHT
        ) {
            console.warn(
                "Khong xac dinh duoc vi tri san pham:",
                product
            );
            return;
        }

        px = toCanvasX(x);
        py = toCanvasY(y);
    }

    // Danh dau vi tri tiep can
    ctx.beginPath();
    ctx.arc(px, py, 13, 0, Math.PI * 2);
    ctx.strokeStyle = COLORS.highlight;
    ctx.lineWidth = 5;
    ctx.stroke();

    // Danh dau ke chua san pham
    if (shelf) {
        const sx = toCanvasX(shelf.x);
        const sy = toCanvasY(shelf.y);
        const sw = logicalWidthToPixel(shelf.width);
        const sh = logicalHeightToPixel(shelf.height);

        ctx.strokeStyle = COLORS.highlight;
        ctx.lineWidth = 5;
        ctx.strokeRect(
            sx - 4,
            sy - 4,
            sw + 8,
            sh + 8
        );
    }

    // Hien thi dung ten cua doi tuong duoc truyen vao
    const productName = String(
        product.name ?? "San pham chua co ten"
    ).trim();

    const shelfText = shelf
        ? "Ke " + shelf.id
        : "Chua xac dinh ke";

    ctx.font = "bold 18px Arial";
    ctx.textAlign = "left";
    ctx.textBaseline = "bottom";

    const nameWidth = ctx.measureText(productName).width;

    ctx.font = "bold 14px Arial";
    const shelfWidth = ctx.measureText(shelfText).width;

    const padding = 8;
    const textWidth = Math.max(nameWidth, shelfWidth);

    let labelX = px + 15;
    let labelY = py - 12;

    if (
        labelX + textWidth + padding * 2 > canvas.width
    ) {
        labelX = px - textWidth - padding * 2 - 15;
    }

    labelX = Math.max(
        5,
        Math.min(
            labelX,
            canvas.width - textWidth - padding * 2 - 5
        )
    );

    labelY = Math.max(
        35,
        Math.min(labelY, canvas.height - 5)
    );

    // Nen nhan
    ctx.fillStyle = COLORS.highlightBackground;
    ctx.fillRect(
        labelX,
        labelY - 30,
        textWidth + padding * 2,
        42
    );

    ctx.strokeStyle = COLORS.highlight;
    ctx.lineWidth = 1.5;
    ctx.strokeRect(
        labelX,
        labelY - 30,
        textWidth + padding * 2,
        42
    );

    // Ten san pham
    ctx.font = "bold 18px Arial";
    ctx.fillStyle = "#bf360c";
    ctx.textBaseline = "bottom";

    ctx.fillText(
        productName,
        labelX + padding,
        labelY - 8
    );

    // Ma ke
    ctx.font = "bold 14px Arial";
    ctx.fillStyle = "#37474f";
    ctx.textBaseline = "top";

    ctx.fillText(
        shelfText,
        labelX + padding,
        labelY - 5
    );
}

// ============================================================
// 22. VE BAN DO TONG THE
// ============================================================

export function drawSupermarketMap() {

    drawBackground();

    drawAisles();

    drawZoneLabels();

    // Ve toan bo ke.

    shelves.forEach(drawShelf);

    // Ve diem tiep can.

    shelves.forEach(drawAccessPoint);

    // Cua vao va quay thanh toan.

    drawEntrance();

    drawCheckouts();

    // Hien thi san pham dang duoc tim.

    if (highlightedProduct) {
        drawProductHighlight(highlightedProduct);
    }

    // Ve lai lo trinh neu dang co.

    if (currentRoute) {
        drawRouteOverlay(currentRoute);
    }

}


// ============================================================
// 23. VE PHAN DUONG DI
//
// Ham nay chi ve duong tu cac diem backend tra ve.
// No khong tu tinh A*, Dijkstra hoac TSP.
// ============================================================

function drawRouteOverlay(routePoints) {

    if (
        !Array.isArray(routePoints) ||
        routePoints.length < 2
    ) {
        return;
    }


    const validPoints = routePoints.filter(isValidPoint);

    if (validPoints.length < 2) {
        return;
    }


    ctx.beginPath();

    validPoints.forEach((point, index) => {

        const x = toCanvasX(Number(point.x));

        const y = toCanvasY(Number(point.y));

        if (index === 0) {

            ctx.moveTo(x, y);

        } else {

            ctx.lineTo(x, y);

        }

    });


    ctx.strokeStyle = COLORS.route;

    ctx.lineWidth = 5;

    ctx.lineCap = "round";
    ctx.lineJoin = "round";

    ctx.setLineDash([12, 8]);

    ctx.stroke();

    ctx.setLineDash([]);


    // Danh dau diem bat dau.

    const first = validPoints[0];

    drawMarker(
        Number(first.x),
        Number(first.y),
        COLORS.routeStart,
        "S"
    );


    // Danh dau diem ket thuc.

    const last = validPoints[validPoints.length - 1];

    drawMarker(
        Number(last.x),
        Number(last.y),
        COLORS.routeEnd,
        "F"
    );

}


// ============================================================
// 24. VE LO TRINH TU BACKEND
//
// Vi du:
// drawRoute([
//     { x: 8, y: 91 },
//     { x: 7.5, y: 30 },
//     { x: 43.5, y: 30 }
// ]);
//
// Luu y: vi du tren chi minh hoa cach goi ham.
// Khong phai lo trinh duoc tinh tu dong.
// ============================================================

export function drawRoute(routePoints) {

    if (
        !Array.isArray(routePoints) ||
        routePoints.length < 2
    ) {
        console.warn(
            "Route khong hop le:",
            routePoints
        );

        currentRoute = null;

        drawSupermarketMap();

        return;
    }


    const validPoints = routePoints.filter(isValidPoint);

    if (validPoints.length < 2) {

        console.warn(
            "Route khong co du diem toa do hop le:",
            routePoints
        );

        currentRoute = null;

        drawSupermarketMap();

        return;
    }


    currentRoute = validPoints.map(point => ({
        x: Number(point.x),
        y: Number(point.y)
    }));


    drawSupermarketMap();

}


// ============================================================
// 25. HIGHLIGHT SAN PHAM
// ============================================================

export function highlightProductOnMap(product) {
    if (!product) {
        highlightedProduct = null;
        drawSupermarketMap();
        return;
    }

    // Tao ban sao de tranh doi tuong bi thay doi tu ben ngoai
    highlightedProduct = {
        ...product,
        name: String(product.name ?? "").trim(),
        shelfId: product.shelfId,
        xCoord: product.xCoord,
        yCoord: product.yCoord
    };

    console.log(
        "[MAP] San pham dang duoc highlight:",
        highlightedProduct.name,
        "| ID:",
        highlightedProduct.id,
        "| Ke:",
        highlightedProduct.shelfId
    );

    drawSupermarketMap();
}
