// ============================================================
// 8. CHUYEN TOA DO LOGIC SANG PIXEL
// ============================================================

function toCanvasX(x) {
    return (Number(x) / MAP_WIDTH) * canvas.width;
}

function toCanvasY(y) {
    return (Number(y) / MAP_HEIGHT) * canvas.height;
}

function logicalWidthToPixel(width) {
    return (width / MAP_WIDTH) * canvas.width;
}

function logicalHeightToPixel(height) {
    return (height / MAP_HEIGHT) * canvas.height;
}


// ============================================================
// 9. KIEM TRA TOA DO
// ============================================================

function isValidPoint(point) {

    if (!point) {
        return false;
    }

    const x = Number(point.x);
    const y = Number(point.y);

    return (
        Number.isFinite(x) &&
        Number.isFinite(y) &&
        x >= 0 &&
        x <= MAP_WIDTH &&
        y >= 0 &&
        y <= MAP_HEIGHT
    );
}


// ============================================================
// 10. VE NEN BAN DO
// ============================================================

function drawBackground() {

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = COLORS.background;

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    // Luoi toa do nhe.

    ctx.strokeStyle = COLORS.grid;
    ctx.lineWidth = 1;

    for (let x = 0; x <= MAP_WIDTH; x += 5) {

        const px = toCanvasX(x);

        ctx.beginPath();

        ctx.moveTo(px, 0);
        ctx.lineTo(px, canvas.height);

        ctx.stroke();
    }

    for (let y = 0; y <= MAP_HEIGHT; y += 5) {

        const py = toCanvasY(y);

        ctx.beginPath();

        ctx.moveTo(0, py);
        ctx.lineTo(canvas.width, py);

        ctx.stroke();
    }

    // Vien ngoai sieu thi.

    ctx.strokeStyle = COLORS.border;
    ctx.lineWidth = 3;

    ctx.strokeRect(
        2,
        2,
        canvas.width - 4,
        canvas.height - 4
    );
}


// ============================================================
// 11. VE LOI DI
// ============================================================

function drawAisles() {

    // Nen loi di ngang.

    ctx.fillStyle = COLORS.aisle;

    const horizontalAisles = [
        { y: 11, height: 3 },
        { y: 30, height: 4 },
        { y: 49, height: 4 },
        { y: 68, height: 4 },
        { y: 79, height: 3 }
    ];

    horizontalAisles.forEach(aisle => {

        ctx.fillRect(
            toCanvasX(2),
            toCanvasY(aisle.y),
            logicalWidthToPixel(96),
            logicalHeightToPixel(aisle.height)
        );

    });


    // Loi di doc giua cac cot ke.

    const verticalAisles = [
        { x: 12, width: 3 },
        { x: 24, width: 3 },
        { x: 36, width: 3 },
        { x: 48, width: 3 },
        { x: 60, width: 3 },
        { x: 72, width: 3 },
        { x: 84, width: 3 }
    ];

    verticalAisles.forEach(aisle => {

        ctx.fillRect(
            toCanvasX(aisle.x),
            toCanvasY(14),
            logicalWidthToPixel(aisle.width),
            logicalHeightToPixel(64)
        );

    });


    // Loi di chinh gan cua vao va quay thanh toan.

    ctx.fillStyle = COLORS.mainAisle;

    ctx.fillRect(
        toCanvasX(2),
        toCanvasY(82),
        logicalWidthToPixel(96),
        logicalHeightToPixel(7)
    );


    // Duong phan cach khu vuc trung tam.

    ctx.strokeStyle = COLORS.aisleBorder;
    ctx.lineWidth = 1.5;

    ctx.strokeRect(
        toCanvasX(2),
        toCanvasY(14),
        logicalWidthToPixel(96),
        logicalHeightToPixel(64)
    );
}


// ============================================================
// 12. VE TIEU DE KHU VUC
// ============================================================

function drawZoneLabels() {

    zones.forEach((zone, index) => {

        const centerX = shelfColumns[index] + SHELF_WIDTH / 2;

        const labelX = toCanvasX(centerX);

        const labelY = toCanvasY(6);

        // Hinh nen tieu de.

        ctx.fillStyle = zone.color;

        ctx.fillRect(
            toCanvasX(shelfColumns[index] - 1),
            toCanvasY(2.5),
            logicalWidthToPixel(9),
            logicalHeightToPixel(6.5)
        );

        // Ma khu.

        ctx.fillStyle = COLORS.text;

        ctx.font = "bold 18px Arial";

        ctx.textAlign = "center";
        ctx.textBaseline = "middle";

        ctx.fillText(
            zone.id,
            labelX,
            labelY - 7
        );

        // Ten khu.

        ctx.font = "bold 15px Arial";

        ctx.fillText(
            zone.name,
            labelX,
            labelY + 9
        );

    });

}


// ============================================================
// 13. VE MOT CUM KE
// ============================================================

function drawShelf(shelf) {

    const x = toCanvasX(shelf.x);
    const y = toCanvasY(shelf.y);

    const width = logicalWidthToPixel(shelf.width);
    const height = logicalHeightToPixel(shelf.height);


    // Bong ke.

    ctx.fillStyle = "rgba(38, 50, 56, 0.15)";

    ctx.fillRect(
        x + 3,
        y + 3,
        width,
        height
    );


    // Than ke.

    ctx.fillStyle = shelf.color;

    ctx.fillRect(
        x,
        y,
        width,
        height
    );


    // Vien ke.

    ctx.strokeStyle = COLORS.shelfBorder;
    ctx.lineWidth = 2;

    ctx.strokeRect(
        x,
        y,
        width,
        height
    );


    // Cac vach ngan tren ke.

    ctx.strokeStyle = "rgba(38, 50, 56, 0.20)";
    ctx.lineWidth = 1;

    for (let i = 1; i < 4; i++) {

        const lineX = x + width * i / 4;

        ctx.beginPath();

        ctx.moveTo(lineX, y + 3);
        ctx.lineTo(lineX, y + height - 3);

        ctx.stroke();
    }


    // Ma ke.

    ctx.fillStyle = COLORS.shelfText;

    ctx.font = "bold 18px Arial";

    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    ctx.fillText(
        shelf.label,
        x + width / 2,
        y + height / 2
    );

}


// ============================================================
// 14. VE DIEM TIEP CAN KE
// ============================================================

function drawAccessPoint(shelf) {

    const x = toCanvasX(shelf.accessX);
    const y = toCanvasY(shelf.accessY);

    // Duong noi ngan tu ke toi diem tiep can.

    const shelfBottom = toCanvasY(
        shelf.y + shelf.height
    );

    ctx.beginPath();

    ctx.moveTo(x, shelfBottom);
    ctx.lineTo(x, y);

    ctx.strokeStyle = "#9eaaa3";
    ctx.lineWidth = 1.5;

    ctx.stroke();


    // Cham do danh dau diem tiep can.

    ctx.beginPath();

    ctx.arc(
        x,
        y,
        5,
        0,
        Math.PI * 2
    );

    ctx.fillStyle = COLORS.access;
    ctx.fill();

    ctx.strokeStyle = "#ffffff";
    ctx.lineWidth = 2;

    ctx.stroke();

}


// ============================================================
// 15. VE MARKER
// ============================================================

function drawMarker(x, y, color, label) {

    const px = toCanvasX(x);
    const py = toCanvasY(y);

    ctx.beginPath();

    ctx.arc(
        px,
        py,
        8,
        0,
        Math.PI * 2
    );

    ctx.fillStyle = color;
    ctx.fill();

    ctx.strokeStyle = "#ffffff";
    ctx.lineWidth = 2;

    ctx.stroke();

    ctx.fillStyle = "#ffffff";

    ctx.font = "bold 11px Arial";

    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    ctx.fillText(
        label,
        px,
        py
    );

}


// ============================================================
// 16. VE CUA VAO
