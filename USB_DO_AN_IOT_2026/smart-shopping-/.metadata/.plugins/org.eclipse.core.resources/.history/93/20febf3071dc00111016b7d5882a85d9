  { id: 'TRAI-TREN', label: 'TRAI TREN', x: 2, y: 11, width: 4, height: 35 },
  { id: 'TRAI-DUOI', label: 'TRAI DUOI', x: 2, y: 70, width: 4, height: 35 },
  { id: 'PHAI-TREN', label: 'PHAI TREN', x: 74, y: 11, width: 4, height: 35 },
  { id: 'PHAI-DUOI', label: 'PHAI DUOI', x: 74, y: 70, width: 4, height: 35 }
