  return {
    id: `K${i + 1}`,
    x: CENTER_X[col], y: CENTER_Y[row],
    width: 4.5, height: 25,
    zoneId: zone.id, color: zone.color,
    zone: zone.fullName, label: `K${i + 1}`
  };
});

// Ke tuong va ke goc duoc TACH thanh cac doan (co khe ho).
// Don vi: x, y, width, height (cm); cao Formex de xuat 10 cm.
const wallShelves = [
  { id: 'SAU-TRAI', label: 'SAU TRAI', x: 3, y: 3, width: 13, height: 3.5 },
  { id: 'SAU-GIUA', label: 'SAU GIUA', x: 19, y: 3, width: 42, height: 3.5 },
