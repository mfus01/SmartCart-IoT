);

let highlightedProduct = null;
let currentRoute = null;
let cartPosition = { x: ENTRANCE.x, y: ENTRANCE.y };
let cartProductsOnMap = [];

function valid(point) {
  return point != null && point.x != null && point.y != null
    && Number.isFinite(Number(point.x)) && Number.isFinite(Number(point.y))
    && Number(point.x) >= 0 && Number(point.x) <= MAP_WIDTH
    && Number(point.y) >= 0 && Number(point.y) <= MAP_HEIGHT;
}
function rect(x, y, w, h, color) {
  ctx.fillStyle = color;
  ctx.fillRect(px(x), py(y), pw(w), ph(h));
}
function border(x, y, w, h, color = '#607d8b', line = 1.8) {
  ctx.strokeStyle = color;
  ctx.lineWidth = line;
  ctx.strokeRect(px(x), py(y), pw(w), ph(h));
}
function textCenter(label, x, y, size = 15, color = '#263238', maxWidth = undefined) {
  ctx.fillStyle = color;
  ctx.font = `bold ${size}px Arial, sans-serif`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(String(label), px(x), py(y), maxWidth);
}
function marker(x, y, color, label, radius = 10) {
  ctx.beginPath();
  ctx.arc(px(x), py(y), radius, 0, Math.PI * 2);
  ctx.fillStyle = color;
  ctx.fill();
  ctx.strokeStyle = '#ffffff';
  ctx.lineWidth = 2;
  ctx.stroke();
  ctx.fillStyle = '#ffffff';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.font = `bold ${label && String(label).length > 1 ? 11 : 13}px Arial`;
  ctx.fillText(String(label), px(x), py(y));
}

function drawBackground() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  rect(0, 0, 80, 120, '#f5f9fa');
  // Luoi 5 cm, dung de doi chieu voi sa ban 80 x 120 cm.
  ctx.strokeStyle = '#e1ebec';
  ctx.lineWidth = 1;
  for (let x = 0; x <= 80; x += 5) {
    ctx.beginPath(); ctx.moveTo(px(x), 0); ctx.lineTo(px(x), canvas.height); ctx.stroke();
  }
  for (let y = 0; y <= 120; y += 5) {
    ctx.beginPath(); ctx.moveTo(0, py(y)); ctx.lineTo(canvas.width, py(y)); ctx.stroke();
  }
  // Vien tuong, chua cua 20 cm tai x=7..27 o canh DUOI.
  ctx.strokeStyle = '#34546c';
  ctx.lineWidth = 11;
  ctx.beginPath();
  ctx.moveTo(px(0.6), py(119.4));
  ctx.lineTo(px(0.6), py(0.6));
  ctx.lineTo(px(79.4), py(0.6));
  ctx.lineTo(px(79.4), py(119.4));
  ctx.lineTo(px(27), py(119.4));
  ctx.moveTo(px(7), py(119.4));
  ctx.lineTo(px(0.6), py(119.4));
  ctx.stroke();
  textCenter('CUA VAO / RA 20 cm', 17, 118.1, 13, '#27664a', 180);
}

function drawBlock(item, fill, stroke = '#5d7080') {
  ctx.fillStyle = 'rgba(45,68,85,.16)';
  ctx.fillRect(px(item.x) + 4, py(item.y) + 4, pw(item.width), ph(item.height));
  rect(item.x, item.y, item.width, item.height, fill);
  border(item.x, item.y, item.width, item.height, stroke, 2);
}
function drawWallShelves() {
  wallShelves.forEach(s => {
    drawBlock(s, '#a4c2d5', '#4a7488');
    if (s.height > s.width) {
      ctx.save();
      ctx.translate(px(s.x + s.width / 2), py(s.y + s.height / 2));
      ctx.rotate(-Math.PI / 2);
      ctx.font = 'bold 14px Arial';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillStyle = '#204354';
      ctx.fillText(s.label, 0, 0, ph(s.height) - 16);
      ctx.restore();
    } else {
      textCenter(s.label, s.x + s.width / 2, s.y + s.height / 2,
        s.width < 15 ? 12 : 15, '#204354', pw(s.width) - 8);
    }
  });
  EXTRA.forEach(s => {
    drawBlock(s, '#dfd4f5', '#8367a8');
    textCenter(s.label, s.x + s.width / 2, s.y + s.height / 2, 15, '#4b3273');
  });
}
function drawCenterShelves() {
  centerShelves.forEach((s, index) => {
    drawBlock(s, s.color, '#445967');
    // Chia than ke thanh 3 doan gan nhan A1...H3; khong tao 24 ke vat ly.
    for (let part = 1; part <= 3; part++) {
      const sub = shelves[index * 3 + part - 1];
      if (part > 1) {
        ctx.beginPath();
        ctx.moveTo(px(s.x), py(sub.y));
        ctx.lineTo(px(s.x + s.width), py(sub.y));
        ctx.strokeStyle = 'rgba(38,50,56,.35)';
        ctx.lineWidth = 2;
        ctx.stroke();
      }
      textCenter(sub.id, sub.x + sub.width / 2, sub.y + sub.height / 2,
        16, '#153943', pw(sub.width) - 4);
    }
    textCenter(s.id, s.x + s.width / 2, s.y - 1.2, 16, '#355161');
  });
}
function drawDeli() {
  drawBlock(DELI, '#ffdc9b', '#bc7d2f');
  textCenter('QUAY AM THUC - BANH - DO AN CHE BIEN SAN',
    40, 58.0, 18, '#885016', pw(42));
  for (let x = 21; x < 61; x += 6) {
    rect(x, 61, 4, 3.1, '#ffb65b');
    border(x, 61, 4, 3.1, '#dd8d36', 1);
  }
}
function drawCheckouts() {
  CHECKOUTS.forEach(q => {
    drawBlock(q, '#ffe2bd', '#db883c');
    textCenter(q.label, q.x + q.width / 2, q.y + q.height / 2,
      14, '#84511d', pw(q.width) - 10);
  });
}
function drawAccessPoints() {
  // Cac cham nho ben ngoai than ke cho biet noi xe dung de lay hang.
  shelves.forEach(s => {
    ctx.beginPath();
    ctx.arc(px(s.accessX), py(s.accessY), 4.2, 0, Math.PI * 2);
    ctx.fillStyle = '#c85349';
    ctx.fill();
  });
}
function normalizeId(id) {
  let key = String(id ?? '').trim().toUpperCase();
  if (/^[A-H]$/.test(key)) key += '1';
  if (/^K[1-8]$/.test(key)) {
    const zone = String.fromCharCode(64 + Number(key.slice(1)));
    key = `${zone}2`;
  }
  if (key === 'AM-THUC' || key === 'DELI') key = 'FOOD';
  return key;
}
function findShelf(id) {
  const key = normalizeId(id);
  return key === 'FOOD' ? DELI : (shelves.find(s => s.id === key) || null);
}
function productPoint(product) {
  const shelf = findShelf(product?.shelfId);
  if (shelf) return { shelf, x: shelf.accessX, y: shelf.accessY };
  const fallback = { x: product?.xCoord, y: product?.yCoord };
  return valid(fallback) ? { shelf: null, x: Number(fallback.x), y: Number(fallback.y) } : null;
}
function drawProductHighlight(product) {
  const loc = productPoint(product);
  if (!loc) return;
  ctx.strokeStyle = '#fb8c00';
  ctx.lineWidth = 4;
  if (loc.shelf) border(loc.shelf.x, loc.shelf.y, loc.shelf.width, loc.shelf.height, '#fb8c00', 4);
  ctx.beginPath();
  ctx.arc(px(loc.x), py(loc.y), 13, 0, Math.PI * 2);
  ctx.stroke();
  const label = String(product.name || 'San pham');
  ctx.font = 'bold 14px Arial';
  const w = Math.min(265, ctx.measureText(label).width + 20);
  const x = Math.max(7, Math.min(px(loc.x) + 13, canvas.width - w - 7));
  const y = Math.max(8, py(loc.y) - 41);
  ctx.fillStyle = '#fff8e1';
  ctx.fillRect(x, y, w, 30);
  ctx.strokeStyle = '#ff9800';
  ctx.lineWidth = 1;
  ctx.strokeRect(x, y, w, 30);
  ctx.fillStyle = '#943a10';
  ctx.textAlign = 'left';
  ctx.textBaseline = 'middle';
  ctx.fillText(label, x + 8, y + 15, w - 14);
}
function drawRouteOverlay(points) {
  if (!Array.isArray(points) || points.length < 2) return;
  ctx.save();
  ctx.beginPath();
  points.forEach((p, i) => {
    if (i === 0) ctx.moveTo(px(p.x), py(p.y));
    else ctx.lineTo(px(p.x), py(p.y));
  });
  ctx.strokeStyle = '#8e24aa';
  ctx.lineWidth = 5;
  ctx.lineJoin = 'round';
  ctx.lineCap = 'round';
  ctx.setLineDash([12, 8]);
  ctx.stroke();
  ctx.restore();
  marker(points[0].x, points[0].y, '#2e7d32', 'S', 10);
  const last = points[points.length - 1];
  marker(last.x, last.y, '#c62828', 'F', 10);
}
function getCartShelfGroups() {
  const groups = [];
  const byShelf = new Map();
  cartProductsOnMap.forEach(product => {
    if (!product || !product.name) return;
    const loc = productPoint(product);
    if (!loc) return;
    const key = loc.shelf ? loc.shelf.id : `${loc.x}:${loc.y}`;
    if (!byShelf.has(key)) {
      const group = {
        index: groups.length + 1, shelf: loc.shelf,
        x: loc.x, y: loc.y, products: []
      };
      byShelf.set(key, group);
      groups.push(group);
    }
    byShelf.get(key).products.push(product);
  });
  return groups;
}
function drawCartMarkers() {
  getCartShelfGroups().forEach(group => {
    if (group.shelf) {
      border(group.shelf.x, group.shelf.y, group.shelf.width,
        group.shelf.height, '#ff9800', 4);
    }
    marker(group.x, group.y, '#ef6c00', group.index, 11);
  });
}
function updateCartMapLegend() {
  let legend = document.getElementById('cartMapLegend');
  if (!legend) {
    legend = document.createElement('div');
    legend.id = 'cartMapLegend';
    legend.style.cssText = 'width:100%;max-width:560px;margin-top:8px;padding:10px;'+
      'background:#fff8e1;border:1px solid #ffcc80;border-radius:8px;'+
      'max-height:150px;overflow-y:auto;font:13px Arial,sans-serif;';
    canvas.insertAdjacentElement('afterend', legend);
  }
  legend.replaceChildren();
  const groups = getCartShelfGroups();
  legend.style.display = groups.length ? 'block' : 'none';
  if (!groups.length) return;
  const header = document.createElement('strong');
  header.textContent = `🛒 Cac vi tri can ghe (${groups.length})`;
  legend.appendChild(header);
  groups.forEach(group => {
    const row = document.createElement('div');
    row.style.cssText = 'margin-top:7px;line-height:1.4;';
    const name = group.shelf
      ? (group.shelf.physicalShelfId
        ? `${group.shelf.physicalShelfId} - ${group.shelf.id}`
        : 'QUAY AM THUC')
      : `(${group.x}, ${group.y})`;
    const products = group.products.map(p => `${p.name} (x${Number(p.quantity) || 1})`).join(', ');
    row.textContent = `${group.index}. ${name}: ${products}`;
    legend.appendChild(row);
  });
}

// =====================================================================
// RFID SMOOTH TRACKING V7 (CHI DOI HIEU UNG, KHONG DOI TOA DO SQLITE)
// - Poll API RFID co chong request chong cheo.
// - Noi suy tren lo di hop le: kiem tra va cham + A* noi bo 1cm.
// - Khi co RFID moi: doi dich tu toa do dang HIEN THI, khong giat ve moc cu.
// - Chi chay RAF khi can; nen ban do duoc cache de ve nhanh.
// - Khong du doan vi tri giua 2 lan doc RFID (khong phai GPS).
// =====================================================================
const RFID_POLL_MS = 220;
const RFID_REQUEST_TIMEOUT_MS = 1800;
const RFID_CM_PER_SECOND = 29; // toc do HIEU UNG, khong phai toc do xe that
const RFID_MIN_DURATION_MS = 180;
const RFID_MAX_DURATION_MS = 1150;
const RFID_CLEARANCE_CM = 0.75; // de phong ban do: ke khong bi xuyen qua
const RFID_RENDER_STEP_MS = 30; // ~33fps, tiet kiem CPU

const rfidObstacles = [
  ...centerShelves, ...wallShelves, DELI, ...EXTRA, ...CHECKOUTS
];
let lastRFIDSignature = null;
let rfidTrackingOn = false;
let rfidPollTimer = null;
let rfidPollGeneration = 0;
let rfidPolling = false;
let rfidMotionFrame = null;
let rfidMotionId = 0;
let rfidHadFirstFix = false;
let lastRFIDErrorLog = 0;

function buildStaticMapCache() {
  if (!staticMapCtx) return;
  const previous = ctx;
  try {
    ctx = staticMapCtx;
    drawBackground();
    drawWallShelves();
    drawCenterShelves();
    drawDeli();
    drawCheckouts();
    drawAccessPoints();
    staticMapReady = true;
  } finally {
    ctx = previous;
  }
}

function rfidWalkable(p) {
  if (!valid(p)) return false;
  const x = Number(p.x), y = Number(p.y);
  if (x < 1.4 || x > 78.6 || y < 1.4 || y > 118.6) return false;
  return !rfidObstacles.some(o =>
    x >= o.x - RFID_CLEARANCE_CM && x <= o.x + o.width + RFID_CLEARANCE_CM &&
    y >= o.y - RFID_CLEARANCE_CM && y <= o.y + o.height + RFID_CLEARANCE_CM
  );
}

// Kiem tra MOI doan duong voi buoc <= 0.5cm; khong cat ngang than ke.
function rfidLineClear(a, b) {
  const d = Math.hypot(b.x - a.x, b.y - a.y);
  const steps = Math.max(1, Math.ceil(d / 0.5));
  for (let i = 0; i <= steps; ++i) {
    const t = i / steps;
    if (!rfidWalkable({x: a.x + (b.x-a.x)*t, y: a.y + (b.y-a.y)*t})) return false;
  }
  return true;
}

// Hang doi uu tien min-heap cho A*, rat nhe tren grid 81 x 121.
function rfidHeapPush(heap, item) {
  heap.push(item);
  let i = heap.length - 1;
  while (i > 0) {
    const parent = Math.floor((i-1)/2);
    if (heap[parent].f <= item.f) break;
    heap[i] = heap[parent];
    i = parent;
  }
  heap[i] = item;
}
function rfidHeapPop(heap) {
  const first = heap[0];
  const last = heap.pop();
  if (heap.length) {
    let i = 0;
    while (i*2+1 < heap.length) {
      let c = i*2+1;
      if (c+1 < heap.length && heap[c+1].f < heap[c].f) c++;
      if (last.f <= heap[c].f) break;
      heap[i] = heap[c];
      i = c;
    }
    heap[i] = last;
  }
  return first;
}

function rfidNearestGridPoint(p) {
  const x0 = Math.round(p.x), y0 = Math.round(p.y);
  for (let radius=0; radius<=4; radius++) {
    let best = null;
    let bestDist = Infinity;
    for (let dx=-radius; dx<=radius; dx++) {
      for (let dy=-radius; dy<=radius; dy++) {
        if (Math.max(Math.abs(dx),Math.abs(dy)) !== radius) continue;
        const q={x:x0+dx,y:y0+dy};
        if (rfidWalkable(q) && rfidLineClear(p,q)) {
          const dist=Math.hypot(p.x-q.x,p.y-q.y);
          if (dist<bestDist) {best=q;bestDist=dist;}
        }
      }
    }
    if (best) return best;
  }
  return null;
}

function rfidAStar(start, goal) {
  const sx = rfidNearestGridPoint(start);
  const gx = rfidNearestGridPoint(goal);
  if (!sx || !gx) return null;
  const cols=81, rows=121, n=cols*rows;
  const index=(x,y)=>y*cols+x;
  const startI=index(sx.x,sx.y), goalI=index(gx.x,gx.y);
  const gScore=new Float64Array(n);
  gScore.fill(Infinity);
  const cameFrom=new Int32Array(n);
  cameFrom.fill(-1);
  const closed=new Uint8Array(n);
  const open=[];
  gScore[startI]=0;
  rfidHeapPush(open,{i:startI,f:Math.abs(sx.x-gx.x)+Math.abs(sx.y-gx.y)});
  const directions=[[1,0],[-1,0],[0,1],[0,-1]];
  while(open.length) {
    const node=rfidHeapPop(open);
    const i=node.i;
    if(closed[i]) continue;
    if(i===goalI) {
      const path=[];
      let j=i;
      for(let steps=0;j!==-1 && steps<n;steps++) {
        path.push({x:j%cols,y:Math.floor(j/cols)});
        j=cameFrom[j];
      }
      path.reverse();
      return path;
    }
    closed[i]=1;
    const x=i%cols,y=Math.floor(i/cols);
    for(const [dx,dy] of directions) {
      const nx=x+dx,ny=y+dy;
      if(nx<0||nx>=cols||ny<0||ny>=rows) continue;
      const next=index(nx,ny);
      if(closed[next]||!rfidWalkable({x:nx,y:ny})) continue;
      const g=gScore[i]+1;
      if(g < gScore[next]) {
        gScore[next]=g;
        cameFrom[next]=i;
        rfidHeapPush(open,{i:next,f:g+Math.abs(nx-gx.x)+Math.abs(ny-gx.y)});
      }
    }
  }
  return null;
}

// Rut gon duong A* thanh nhung doan thang NHIN THAY NHAU,
// nen duong di mem hon ma van khong xuyen qua ke.
function rfidBuildPath(from,to) {
  if(!rfidWalkable(from)||!rfidWalkable(to)) return null;
  if(rfidLineClear(from,to)) return [from,to];
  const grid=rfidAStar(from,to);
  if(!grid||!grid.length) return null;
  const raw=[from,...grid,to];
  const result=[from];
  let i=0;
  while(i<raw.length-1) {
    let j=raw.length-1;
    while(j>i+1 && !rfidLineClear(raw[i],raw[j])) --j;
    if(!rfidLineClear(raw[i],raw[j])) return null;
    result.push(raw[j]);
    i=j;
  }
  return result;
}

function cancelRFIDMotion() {
  ++rfidMotionId;
  if (rfidMotionFrame !== null) cancelAnimationFrame(rfidMotionFrame);
  rfidMotionFrame = null;
}
function setRFIDDisplayedPosition(p) {
  cartPosition = {x:Number(p.x),y:Number(p.y)};
  drawSupermarketMap();
}

function animateToRFID(p) {
  if (!valid(p)) return;
  const target={x:Number(p.x),y:Number(p.y)};
  const from={...cartPosition}; // lay diem X DANG HIEN THI, khong phai moc cu
  cancelRFIDMotion();
  if (!rfidHadFirstFix || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    rfidHadFirstFix=true;
    setRFIDDisplayedPosition(target);
    return;
  }
  const path=rfidBuildPath(from,target);
  if (!path) {
    // Khong co duong di an toan -> cap nhat ngay, TUYET DOI KHONG noi xuyen ke.
    console.warn('[RFID MAP] Khong tim duoc duong di hop le, chuyen truc tiep:',from,target);
    setRFIDDisplayedPosition(target);
    return;
  }
  const lengths=[];
  let total=0;
  for(let i=1;i<path.length;i++) {
    const d=Math.hypot(path[i].x-path[i-1].x,path[i].y-path[i-1].y);
    lengths.push(d); total+=d;
  }
  if(total<0.1){setRFIDDisplayedPosition(target);return;}
  const duration=Math.max(RFID_MIN_DURATION_MS,
    Math.min(RFID_MAX_DURATION_MS,total/RFID_CM_PER_SECOND*1000));
  const myId=rfidMotionId;
  let started=null, lastDraw=-Infinity;
  const ease=t=>t*t*(3-2*t);
  function frame(now) {
    if(myId!==rfidMotionId) return;
    if(started===null)started=now;
    const ratio=Math.min(1,(now-started)/duration);
    if(now-lastDraw>=RFID_RENDER_STEP_MS||ratio>=1) {
      lastDraw=now;
      let remaining=ease(ratio)*total;
      let pos=target;
      for(let i=0;i<lengths.length;i++) {
        const len=lengths[i];
        if(remaining<=len||i===lengths.length-1) {
          const t=len===0?1:Math.max(0,Math.min(1,remaining/len));
          const a=path[i],b=path[i+1];
          pos={x:a.x+(b.x-a.x)*t,y:a.y+(b.y-a.y)*t};
          break;
        }
        remaining-=len;
      }
      setRFIDDisplayedPosition(pos);
    }
    if(ratio<1) rfidMotionFrame=requestAnimationFrame(frame);
    else {rfidMotionFrame=null;setRFIDDisplayedPosition(target);}
  }
  rfidMotionFrame=requestAnimationFrame(frame);
}

async function rfidPollOnce(generation) {
  if(!rfidTrackingOn || rfidPolling || generation!==rfidPollGeneration) return;
  rfidPolling=true;
  const controller=new AbortController();
  const timeout=setTimeout(()=>controller.abort(),RFID_REQUEST_TIMEOUT_MS);
  try {
    const res=await fetch('/api/rfid/position',{
      cache:'no-store',signal:controller.signal
    });
    if(!res.ok) throw new Error('HTTP '+res.status);
    const data=await res.json();
    if(generation!==rfidPollGeneration||!rfidTrackingOn) return;
    if(!valid(data)||data.success===false) return;
    const p={x:Number(data.x),y:Number(data.y)};
    const sig=`${data.uid??data.location??''}|${p.x.toFixed(2)}|${p.y.toFixed(2)}`;
    if(sig!==lastRFIDSignature) {
      lastRFIDSignature=sig;
      animateToRFID(p);
    }
  } catch(err) {
    const now=Date.now();
    if(generation===rfidPollGeneration&&now-lastRFIDErrorLog>10000) {
      lastRFIDErrorLog=now;
      console.warn('[RFID MAP] Chua lay duoc vi tri RFID:',err.message);
    }
  } finally {
    clearTimeout(timeout);
    rfidPolling=false;
    if(rfidTrackingOn&&generation===rfidPollGeneration) {
      rfidPollTimer=setTimeout(()=>rfidPollOnce(generation),RFID_POLL_MS);
    }
  }
}

// Goi tu dong khi nap map.js; khong can sua main.js.
export function startRFIDTracking() {
  if(rfidTrackingOn) return;
  rfidTrackingOn=true;
  const generation=++rfidPollGeneration;
  rfidPollOnce(generation);
}
export function stopRFIDTracking() {
  rfidTrackingOn=false;
  ++rfidPollGeneration;
  if(rfidPollTimer!==null)clearTimeout(rfidPollTimer);
  rfidPollTimer=null;
  cancelRFIDMotion();
  // Khi bat lai: cho 1 moc RFID moi de xac nhan truc quan.
  lastRFIDSignature=null;
  rfidHadFirstFix=false;
}

// =========================== PUBLIC API: GIU TEN HAM CU ===========================
export function drawSupermarketMap() {
  if (staticMapReady) {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(staticMapCanvas, 0, 0);
  } else {
    drawBackground();
    drawWallShelves();
    drawCenterShelves();
    drawDeli();
    drawCheckouts();
    drawAccessPoints();
  }
  if (currentRoute) drawRouteOverlay(currentRoute);
  if (highlightedProduct) drawProductHighlight(highlightedProduct);
  drawCartMarkers();
  if (valid(cartPosition)) marker(cartPosition.x, cartPosition.y, '#1565c0', 'X', 11);
}
export function drawRoute(points) {
  const good = Array.isArray(points)
    ? points.filter(valid).map(p => ({ x: Number(p.x), y: Number(p.y) })) : [];
  currentRoute = good.length >= 2 ? good : null;
  if (!currentRoute) console.warn('Route khong hop le:', points);
  drawSupermarketMap();
}
export function clearRoute() { currentRoute = null; drawSupermarketMap(); }
export function highlightProductOnMap(product) {
  highlightedProduct = product ? { ...product } : null;
  drawSupermarketMap();
}
export function clearProductHighlight() { highlightedProduct = null; drawSupermarketMap(); }
export function getMapShelves() { return shelves.map(s => ({ ...s })); }
export function getShelfAccessPoint(id) {
  const s = findShelf(id);
  return s ? { x: s.accessX, y: s.accessY } : null;
}
export function getMapZones() { return zones.map(z => ({ ...z })); }
export function getEntrancePoint() { return { x: ENTRANCE.x, y: ENTRANCE.y }; }
export function getCheckoutPoints() {
  return CHECKOUTS.map(q => ({ id: q.id, label: q.label,
    x: q.x + q.width / 2, y: q.y - 5 }));
}
export function getCartPosition() { return { ...cartPosition }; }
// API CU giu nguyen: setCartPosition la VI TRI TU MO PHONG / nguoi dung.
// Khi goi truc tiep, dung hieu ung RFID de tranh tranh chap 2 nguon toa do.
export function setCartPosition(point) {
  if (!valid(point)) return false;
  cancelRFIDMotion();
  cartPosition = { x: Number(point.x), y: Number(point.y) };
  drawSupermarketMap();
  return true;
}
export function setCartProductsOnMap(products) {
  cartProductsOnMap = Array.isArray(products) ? products.map(p => ({ ...p })) : [];
  updateCartMapLegend();
  drawSupermarketMap();
}

// De thu dieu kien khoang cach phuc vu doi chieu Formex va backend.
export function getMapLayoutInfo() {
  return {
    widthCm: MAP_WIDTH, lengthCm: MAP_HEIGHT,
    centerShelves: centerShelves.map(s => ({ ...s })),
    wallShelves: wallShelves.map(s => ({ ...s })),
    deli: { ...DELI }, checkouts: CHECKOUTS.map(s => ({ ...s })),
    entrance: { ...ENTRANCE }
  };
}

