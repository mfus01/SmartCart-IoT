// Chi ve lai lop dong: route, san pham, vi tri xe.
const staticMapCanvas = document.createElement('canvas');
staticMapCanvas.width = canvas.width;
staticMapCanvas.height = canvas.height;
const staticMapCtx = staticMapCanvas.getContext('2d');
let staticMapReady = false;

const px = x => Number(x) / MAP_WIDTH * canvas.width;
const py = y => Number(y) / MAP_HEIGHT * canvas.height;
const pw = w => Number(w) / MAP_WIDTH * canvas.width;
const ph = h => Number(h) / MAP_HEIGHT * canvas.height;

