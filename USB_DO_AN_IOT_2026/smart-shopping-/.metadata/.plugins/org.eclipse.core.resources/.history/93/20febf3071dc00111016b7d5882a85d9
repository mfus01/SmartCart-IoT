// A1/A2/A3 = 3 phan doc ke K1, B1/B2/B3 = 3 phan ke K2 ...
// Diem tiep can la toa do di lai DUOC, KHONG nam trong than ke.
const shelves = centerShelves.flatMap((physical, i) =>
  [1, 2, 3].map(part => {
    const row = Math.floor(i / 4);
    const col = i % 4;
    return {
      id: `${physical.zoneId}${part}`,
      label: `${physical.zoneId}${part}`,
      physicalShelfId: physical.id,
      zoneId: physical.zoneId, zone: physical.zone,
      x: physical.x,
      y: physical.y + (part - 1) * physical.height / 3,
      width: physical.width, height: physical.height / 3,
      accessX: ACCESS_X[col], accessY: ACCESS_Y[row][part - 1],
