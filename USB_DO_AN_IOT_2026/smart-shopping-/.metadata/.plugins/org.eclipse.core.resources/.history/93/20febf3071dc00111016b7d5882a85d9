  { id: 'A', name: 'RAU CU QUA', fullName: 'Rau cu va trai cay', color: '#A5D6A7' },
  { id: 'B', name: 'THIT TUOI', fullName: 'Thit tuoi song', color: '#EF9A9A' },
  { id: 'C', name: 'HAI SAN', fullName: 'Ca va hai san', color: '#80DEEA' },
  { id: 'D', name: 'DONG LANH', fullName: 'Thuc pham dong lanh', color: '#B39DDB' },
  { id: 'E', name: 'GAO, MI', fullName: 'Gao, mi va ngu coc', color: '#90CAF9' },
  { id: 'F', name: 'GIA VI', fullName: 'Gia vi va do kho', color: '#FFE082' },
  { id: 'G', name: 'DO HOP', fullName: 'Do hop va banh keo', color: '#CE93D8' },
  { id: 'H', name: 'DO UONG', fullName: 'Sua va do uong', color: '#80CBC4' }
];

// KE GIUA: moi ke 4.5 cm ngang x 25 cm doc; cao Formex 10 cm.
