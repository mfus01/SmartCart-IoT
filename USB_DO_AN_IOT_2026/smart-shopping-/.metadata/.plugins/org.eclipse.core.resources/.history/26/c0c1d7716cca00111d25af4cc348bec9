function drawCheckout() {
    const x = toCanvasX(CHECKOUT.x - 8);
    const y = toCanvasY(CHECKOUT.y - 4);

    const width =
        (16 / MAP_WIDTH) * canvas.width;

    const height =
        (6 / MAP_HEIGHT) * canvas.height;

    ctx.fillStyle = COLORS.checkout;

    ctx.fillRect(
        x,
        y,
        width,
        height
    );

    ctx.strokeStyle = COLORS.checkoutBorder;
    ctx.lineWidth = 2;

    ctx.strokeRect(
        x,
        y,
        width,
        height
    );

    ctx.fillStyle = COLORS.checkoutText;

    ctx.font = "bold 10px Arial";

    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    ctx.fillText(
        CHECKOUT.label,
        x + width / 2,
        y + height / 2
    );

    drawMarker(
        CHECKOUT.x,
        CHECKOUT.y,
        COLORS.routeEnd,
        "F"
    );
}


// ======================================================
// VE MARKER
// ======================================================

function drawMarker(x, y, color, label) {
    const px = toCanvasX(x);
    const py = toCanvasY(y);

    ctx.beginPath();

    ctx.arc(
        px,
        py,
        6,
        0,
        Math.PI * 2
    );

    ctx.fillStyle = color;
    ctx.fill();

    ctx.strokeStyle = "#ffffff";
    ctx.lineWidth = 2;
    ctx.stroke();

    ctx.fillStyle = "#ffffff";

    ctx.font = "bold 9px Arial";

    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    ctx.fillText(
        label,
        px,
        py
    );
}


// ======================================================
// TIM KE HANG
// ======================================================

function normalizeShelfId(shelfId) {
    if (!shelfId) {
        return null;
    }

    const id = String(shelfId).trim().toUpperCase();

    return shelfAliases[id] || id;
}


function findShelf(shelfId) {
    const normalizedId = normalizeShelfId(shelfId);

    return shelves.find(function (shelf) {
        return shelf.id === normalizedId;
    }) || null;
}


// ======================================================
// VE TOAN BO BAN DO
// ======================================================

export function drawSupermarketMap() {
    drawBackground();

    drawAisles();

    shelves.forEach(function (shelf) {
        drawShelf(shelf);
    });

    shelves.forEach(function (shelf) {
        drawAccessPoint(shelf);
    });

    drawEntrance();

    drawCheckout();

    // Ve lai highlight san pham neu dang co
    if (highlightedProduct) {
        drawProductHighlight(highlightedProduct);
    }
}


// ======================================================
// VE LO TRINH
//
// Chi ve duong di do Backend tra ve.
// Ham nay khong tu tinh A*, Dijkstra hay TSP.
// ======================================================

export function drawRoute(routePoints) {
    if (
        !Array.isArray(routePoints) ||
        routePoints.length < 2
    ) {
        console.warn(
            "Route khong hop le:",
            routePoints
        );

        return;
    }

    // Ve lai ban do sach truoc khi ve route
    drawSupermarketMap();

    ctx.beginPath();

    routePoints.forEach(function (point, index) {
        const x = Number(point.x);
        const y = Number(point.y);

        if (
            !Number.isFinite(x) ||
            !Number.isFinite(y)
        ) {
            return;
        }

        if (index === 0) {
            ctx.moveTo(
                toCanvasX(x),
                toCanvasY(y)
            );
        } else {
            ctx.lineTo(
                toCanvasX(x),
                toCanvasY(y)
            );
        }
    });

    ctx.strokeStyle = COLORS.route;
    ctx.lineWidth = 4;
    ctx.lineJoin = "round";
    ctx.lineCap = "round";

    ctx.setLineDash([8, 5]);

    ctx.stroke();

    ctx.setLineDash([]);

    // Danh dau diem dau va diem cuoi
    const first = routePoints[0];
    const last = routePoints[routePoints.length - 1];

    drawMarker(
        Number(first.x),
        Number(first.y),
        COLORS.routeStart,
        "S"
    );

    drawMarker(
        Number(last.x),
        Number(last.y),
        COLORS.routeEnd,
        "F"
    );
}


// ======================================================
// HIGHLIGHT SAN PHAM
//
// Khong tu ve testRoute nua.
// Chi danh dau diem tiep can va ke chua san pham.
// ======================================================

export function highlightProductOnMap(product) {
    if (!product) {
        return;
    }

    highlightedProduct = product;

    drawSupermarketMap();
}


// ======================================================
// VE HIGHLIGHT SAN PHAM
// ======================================================

function drawProductHighlight(product) {
    const x = Number(product.xCoord);
    const y = Number(product.yCoord);

    if (
        !Number.isFinite(x) ||
        !Number.isFinite(y)
    ) {
        console.warn(
            "San pham khong co toa do hop le:",
            product
        );

        return;
    }

    const px = toCanvasX(x);
    const py = toCanvasY(y);

    // Vong tron highlight diem tiep can
    ctx.beginPath();

    ctx.arc(
        px,
        py,
        10,
        0,
        Math.PI * 2
    );

    ctx.strokeStyle = COLORS.highlight;
    ctx.lineWidth = 4;

    ctx.stroke();

    // Tim va highlight ke
    const shelf = findShelf(product.shelfId);

    if (shelf) {
        const sx = toCanvasX(shelf.x);
        const sy = toCanvasY(shelf.y);

        const sw =
            (shelf.width / MAP_WIDTH) * canvas.width;

        const sh =
            (shelf.height / MAP_HEIGHT) * canvas.height;

        ctx.strokeStyle = COLORS.highlight;
        ctx.lineWidth = 3;

        ctx.strokeRect(
            sx - 3,
            sy - 3,
            sw + 6,
            sh + 6
        );
    }

    // Ten san pham
    ctx.font = "bold 12px Arial";

    ctx.textAlign = "left";
    ctx.textBaseline = "bottom";

    const label =
        String(product.name || "San pham");

    const labelX = Math.min(
        px + 12,
        canvas.width - 150
    );

    const labelY = Math.max(
        py - 8,
        15
    );

    // Nen trang de de doc
    const textWidth = ctx.measureText(label).width;

    ctx.fillStyle = "rgba(255,255,255,0.9)";

    ctx.fillRect(
        labelX - 3,
        labelY - 16,
        textWidth + 6,
        20
    );

    ctx.fillStyle = "#e65100";

    ctx.fillText(
        label,
        labelX,
        labelY
    );
}


// ======================================================
// LAY THONG TIN KE HANG
// Co the dung sau nay de doi chieu database.
// ======================================================

export function getMapShelves() {
    return shelves.map(function (shelf) {
        return {
            id: shelf.id,
            label: shelf.label,
            x: shelf.x,
            y: shelf.y,
            width: shelf.width,
            height: shelf.height,
            accessX: shelf.accessX,
            accessY: shelf.accessY
        };
    });
}


// ======================================================
// LAY DIEM TIEP CAN THEO MA KE
// Vi du: getShelfAccessPoint("A1")
// ======================================================

export function getShelfAccessPoint(shelfId) {
    const shelf = findShelf(shelfId);

    if (!shelf) {
        return null;
    }

    return {
        x: shelf.accessX,
        y: shelf.accessY
    };
}