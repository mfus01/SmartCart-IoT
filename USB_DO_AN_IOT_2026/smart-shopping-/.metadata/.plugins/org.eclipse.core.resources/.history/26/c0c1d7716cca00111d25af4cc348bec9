// ======================================================
// CHUYEN TOA DO LOGIC SANG PIXEL
// ======================================================

function toCanvasX(x) {
    return (x / MAP_WIDTH) * canvas.width;
}

function toCanvasY(y) {
    return (y / MAP_HEIGHT) * canvas.height;
}


// ======================================================
// CHUYEN TOA DO PIXEL SANG LOGIC
// ======================================================

function toLogicX(pixelX) {
    return (pixelX / canvas.width) * MAP_WIDTH;
}

function toLogicY(pixelY) {
    return (pixelY / canvas.height) * MAP_HEIGHT;
}


// ======================================================
// VE NEN
// ======================================================

function drawBackground() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = COLORS.background;

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    // Luoi toa do nhe
    ctx.strokeStyle = COLORS.grid;
    ctx.lineWidth = 1;

    for (let x = 0; x <= MAP_WIDTH; x += 5) {
        const px = toCanvasX(x);

        ctx.beginPath();
        ctx.moveTo(px, 0);
        ctx.lineTo(px, canvas.height);
        ctx.stroke();
    }

    for (let y = 0; y <= MAP_HEIGHT; y += 5) {
        const py = toCanvasY(y);

        ctx.beginPath();
        ctx.moveTo(0, py);
        ctx.lineTo(canvas.width, py);
        ctx.stroke();
    }

    // Vien ban do
    ctx.strokeStyle = COLORS.border;
    ctx.lineWidth = 2;

    ctx.strokeRect(
        2,
        2,
        canvas.width - 4,
        canvas.height - 4
    );
}


// ======================================================
// VE LOI DI
// ======================================================

function drawAisles() {
    // Nen loi di doc
    ctx.fillStyle = COLORS.aisle;

    const aislePositions = [30, 50, 70, 90];

    aislePositions.forEach(function (x) {
        const px = toCanvasX(x);

        ctx.fillRect(
            px - 2,
            toCanvasY(2),
            4,
            toCanvasY(58) - toCanvasY(2)
        );
    });

    // Loi di ngang
    const horizontalAisles = [18, 38, 58, 75];

    horizontalAisles.forEach(function (y) {
        const py = toCanvasY(y);

        ctx.fillRect(
            toCanvasX(5),
            py - 2,
            toCanvasX(95) - toCanvasX(5),
            4
        );
    });
}


// ======================================================
// VE MOT KE HANG
// ======================================================

function drawShelf(shelf) {
    const x = toCanvasX(shelf.x);
    const y = toCanvasY(shelf.y);

    const width =
        (shelf.width / MAP_WIDTH) * canvas.width;

    const height =
        (shelf.height / MAP_HEIGHT) * canvas.height;

    // Bong nhe
    ctx.fillStyle = "rgba(0, 0, 0, 0.08)";

    ctx.fillRect(
        x + 2,
        y + 2,
        width,
        height
    );

    // Than ke
    ctx.fillStyle = shelf.color;

    ctx.fillRect(
        x,
        y,
        width,
        height
    );

    ctx.strokeStyle = COLORS.shelfBorder;
    ctx.lineWidth = 1.5;

    ctx.strokeRect(
        x,
        y,
        width,
        height
    );

    // Thanh ngan ben trong ke
    ctx.strokeStyle = "rgba(13, 71, 161, 0.35)";
    ctx.lineWidth = 1;

    ctx.beginPath();

    ctx.moveTo(
        x + width * 0.25,
        y + 2
    );

    ctx.lineTo(
        x + width * 0.25,
        y + height - 2
    );

    ctx.moveTo(
        x + width * 0.50,
        y + 2
    );

    ctx.lineTo(
        x + width * 0.50,
        y + height - 2
    );

    ctx.moveTo(
        x + width * 0.75,
        y + 2
    );

    ctx.lineTo(
        x + width * 0.75,
        y + height - 2
    );

    ctx.stroke();

    // Ten ke
    ctx.fillStyle = COLORS.shelfText;

    ctx.font = "bold 11px Arial";

    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    ctx.fillText(
        shelf.id,
        x + width / 2,
        y + height / 2
    );
}


// ======================================================
// VE DIEM TIEP CAN
// ======================================================

function drawAccessPoint(shelf) {
    const x = toCanvasX(shelf.accessX);
    const y = toCanvasY(shelf.accessY);

    // Cham tiep can
    ctx.beginPath();

    ctx.arc(
        x,
        y,
        4,
        0,
        Math.PI * 2
    );

    ctx.fillStyle = COLORS.access;
    ctx.fill();

    ctx.strokeStyle = COLORS.accessBorder;
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // Ten diem
    ctx.fillStyle = "#37474f";

    ctx.font = "10px Arial";

    ctx.textAlign = "center";
    ctx.textBaseline = "top";

    ctx.fillText(
        shelf.id,
        x,
        y + 5
    );
}


// ======================================================
// VE CUA VAO
