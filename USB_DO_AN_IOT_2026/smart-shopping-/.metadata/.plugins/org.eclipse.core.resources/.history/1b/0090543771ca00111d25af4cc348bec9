* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #f4f6f8;
    color: #222;
}


/* =========================
   HEADER
   ========================= */

.app-header {
    background: #1565c0;
    color: white;

    padding: 18px 30px;

    box-shadow:
        0 2px 6px rgba(0, 0, 0, 0.15);
}

.app-header h1 {
    margin: 0 0 5px 0;
    font-size: 28px;
}

.app-header p {
    margin: 0;
    font-size: 14px;
}


/* =========================
   BO CUC CHINH
   ========================= */

.main-layout {
    display: grid;

    grid-template-columns:
        minmax(250px, 1fr)
        minmax(450px, 2fr)
        minmax(250px, 1fr);

    gap: 18px;

    padding: 20px;

    height: calc(100vh - 100px);
}


/* =========================
   CAC PANEL
   ========================= */

.chat-panel,
.map-panel,
.cart-panel {
    background: white;

    border-radius: 12px;

    padding: 18px;

    box-shadow:
        0 2px 8px rgba(0, 0, 0, 0.08);

    display: flex;
    flex-direction: column;

    min-height: 500px;
}

.chat-panel h2,
.map-panel h2,
.cart-panel h2 {
    margin-top: 0;
    margin-bottom: 15px;

    font-size: 20px;

    border-bottom:
        2px solid #eeeeee;

    padding-bottom: 10px;
}


/* =========================
   CHATBOT
   ========================= */

.chat-messages {
    flex: 1;

    background: #f7f9fb;

    border:
        1px solid #dddddd;

    border-radius: 8px;

    padding: 12px;

    overflow-y: auto;

    margin-bottom: 12px;
}

.chat-messages p {
    margin-top: 0;

    background: #e3f2fd;

    padding: 10px;

    border-radius: 8px;

    line-height: 1.5;
}

.chat-input-area {
    display: flex;
    gap: 8px;
}

.chat-input-area input {
    flex: 1;

    padding: 11px;

    border:
        1px solid #cccccc;

    border-radius: 7px;

    font-size: 14px;
}

.chat-input-area input:focus {
    outline: none;

    border-color: #1565c0;
}

.chat-input-area button {
    padding: 10px 18px;

    border: none;

    border-radius: 7px;

    background: #1565c0;
    color: white;

    cursor: pointer;

    font-weight: bold;
}

.chat-input-area button:hover {
    background: #0d47a1;
}


/* =========================
   BAN DO SIEU THI
   ========================= */

.supermarket-map {
    flex: 1;

    min-height: 450px;

    border:
        2px solid #cfd8dc;

    border-radius: 10px;

    background: #fafafa;

    display: flex;

    align-items: center;

    justify-content: center;

    overflow: hidden;
}

#mapCanvas {
    display: block;
    width: 100%;
    height: auto;
    background: #f5f7fa;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
}



/* =========================
   GIO HANG
   ========================= */

#cartItems {
    flex: 1;

    background: #f7f9fb;

    border:
        1px solid #dddddd;

    border-radius: 8px;

    padding: 12px;

    overflow-y: auto;
}


/* =========================
   NUT TAO LO TRINH
   ========================= */

.route-button {
    width: 100%;

    margin-top: 15px;

    padding: 11px 15px;

    border: none;

    border-radius: 7px;

    background: #7b1fa2;

    color: white;

    font-size: 15px;

    font-weight: bold;

    cursor: pointer;
}

.route-button:hover {
    background: #6a1b9a;
}


/* =========================
   TONG TIEN
   ========================= */

.cart-summary {
    margin-top: 15px;

    padding-top: 15px;

    border-top:
        2px solid #eeeeee;

    display: flex;

    justify-content: space-between;

    font-size: 17px;
}

#totalPrice {
    font-weight: bold;

    color: #d32f2f;
}


/* =========================
   RESPONSIVE
   ========================= */

@media (max-width: 1000px) {

    .main-layout {
        grid-template-columns: 1fr;

        height: auto;
    }

    .chat-panel,
    .map-panel,
    .cart-panel {
        min-height: 350px;
    }
}