package com.smartcart.controller;

import java.util.ArrayList;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Set;

import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.smartcart.dto.ApiResponse;
import com.smartcart.dto.RoutePoint;
import com.smartcart.dto.RouteProductRequest;
import com.smartcart.dto.RouteRequest;
import com.smartcart.dto.RouteResponse;

@RestController
@RequestMapping("/api")
public class RouteController {

    /*
     * Toa do tiep can ke theo map.js V4.
     * Cot A-H va hang 1-3.
     *
     * RoutePoint su dung int nen toa do duoc lam tron.
     */
    private static final int[] SHELF_X = {
        8, 20, 32, 44, 56, 68, 80, 92
    };

    private static final int[] SHELF_Y = {
        30, 49, 68
    };

    /*
     * Cac duong di ngang quy uoc.
     * Can doi chieu voi map.js neu ban do thay doi.
     */
    private static final int[] AISLE_Y = {
        12, 34, 53, 73, 84
    };

    @PostMapping("/generate-route")
    public ApiResponse<RouteResponse> generateRoute(
            @RequestBody RouteRequest request) {

        if (request == null) {
            return error("Du lieu yeu cau khong hop le");
        }

        if (request.getStartPoint() == null) {
            return error("Thieu diem bat dau");
        }

        if (request.getProducts() == null
                || request.getProducts().isEmpty()) {
            return error("Gio hang dang rong");
        }

        /*
         * Lay danh sach ke can ghe.
         * Neu nhieu san pham cung ke thi chi ghe mot lan.
         */
        Set<String> shelfIds = new LinkedHashSet<>();

        for (RouteProductRequest product : request.getProducts()) {
            if (product == null || product.getShelfId() == null) {
                continue;
            }

            String shelfId = product.getShelfId()
                    .trim()
                    .toUpperCase();

            if (getShelfPoint(shelfId) != null) {
                shelfIds.add(shelfId);
            }
        }

        if (shelfIds.isEmpty()) {
            return error(
                "Khong tim thay ke hop le cho san pham trong gio"
            );
        }

        List<RoutePoint> routePoints = new ArrayList<>();

        int currentX = request.getStartPoint().getX();
        int currentY = request.getStartPoint().getY();

        // Them diem bat dau thuc te tu request
        addPoint(routePoints, currentX, currentY);

        /*
         * Ghe lan luot cac ke theo thu tu trong gio hang.
         * Khong them diem quay thanh toan.
         */
        for (String shelfId : shelfIds) {

            int[] target = getShelfPoint(shelfId);

            int targetX = target[0];
            int targetY = target[1];

            int aisleY = nearestAisleY(targetY);

            /*
             * Tu vi tri hien tai den loi di ngang gan nhat.
             */
            addPoint(routePoints, currentX, aisleY);

            /*
             * Di ngang tren loi di den cot ke dich.
             */
            addPoint(routePoints, targetX, aisleY);

            /*
             * Tiep can ke de lay hang.
             */
            addPoint(routePoints, targetX, targetY);

            currentX = targetX;
            currentY = targetY;
        }

        RouteResponse response = new RouteResponse(routePoints);

        return new ApiResponse<>(
            true,
            "Tao lo trinh lay hang thanh cong",
            response
        );
    }

    private ApiResponse<RouteResponse> error(String message) {
        return new ApiResponse<>(
            false,
            message,
            null
        );
    }

    /*
     * Tra ve toa do tiep can cua ke.
     *
     * A1 = (8,30)
     * H1 = (92,30)
     * A2 = (8,49)
     * H3 = (92,68)
     */
    private int[] getShelfPoint(String shelfId) {

        if (shelfId == null
                || !shelfId.matches("[A-H][1-3]")) {
            return null;
        }

        int column = shelfId.charAt(0) - 'A';
        int row = Character.getNumericValue(
                shelfId.charAt(1)
        ) - 1;

        return new int[] {
            SHELF_X[column],
            SHELF_Y[row]
        };
    }

    private int nearestAisleY(int targetY) {

        int nearest = AISLE_Y[0];
        int minDistance = Math.abs(targetY - nearest);

        for (int aisleY : AISLE_Y) {
            int distance = Math.abs(targetY - aisleY);

            if (distance < minDistance) {
                minDistance = distance;
                nearest = aisleY;
            }
        }

        return nearest;
    }

    /*
     * Them diem va loai bo diem trung lien tiep.
     */
    private void addPoint(
            List<RoutePoint> points,
            int x,
            int y) {

        if (!points.isEmpty()) {
            RoutePoint last = points.get(points.size() - 1);

            if (last.getX() == x && last.getY() == y) {
                return;
            }
        }

        points.add(new RoutePoint(x, y));
    }
}