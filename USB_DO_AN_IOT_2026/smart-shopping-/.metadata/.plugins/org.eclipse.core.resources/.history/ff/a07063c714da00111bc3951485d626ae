    return {
        x: ENTRANCE.x,
        y: ENTRANCE.y
    };
}


// =====================================================
// 30. LAY QUAY THANH TOAN
// =====================================================

export function getCheckoutPoints() {

    return CHECKOUTS.map(q => ({
        ...q
    }));
}


// =====================================================
// 31. LAY VI TRI XE DAY
// =====================================================

export function getCartPosition() {

    return {
        ...cartPosition
    };
}


// =====================================================
// 32. CAP NHAT VI TRI XE DAY
// =====================================================

export function setCartPosition(point) {

    if (!valid(point)) {
        return false;
    }

    cartPosition = {

        x: Number(point.x),

        y: Number(point.y)

    };

    drawSupermarketMap();

    return true;
}


// =====================================================
// 33. DONG BO GIO HANG VOI BAN DO
// =====================================================

export function setCartProductsOnMap(products) {

    cartProductsOnMap = Array.isArray(products)
        ? products.map(p => ({
            ...p
        }))
        : [];

    // Cap nhat danh sach ke
    updateCartMapLegend();

    // Ve lai ban do
    drawSupermarketMap();
}


