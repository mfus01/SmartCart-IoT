    return shelves.map(s => ({
        ...s
    }));
}


// =====================================================
// 27. LAY DIEM TIEP CAN KE
// =====================================================

export function getShelfAccessPoint(id) {

    const s = findShelf(id);

    return s
        ? {
            x: s.accessX,
            y: s.accessY
        }
        : null;
}


