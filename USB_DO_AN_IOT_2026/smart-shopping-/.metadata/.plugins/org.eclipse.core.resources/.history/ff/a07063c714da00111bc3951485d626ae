    throw new Error("Khong tim thay #mapCanvas");
}

const ctx = canvas.getContext("2d");

if (!ctx) {
    throw new Error("Khong ho tro Canvas 2D");
}

const W = 100;
const H = 100;

const px = x => Number(x) / W * canvas.width;
const py = y => Number(y) / H * canvas.height;
const pw = w => Number(w) / W * canvas.width;
const ph = h => Number(h) / H * canvas.height;


