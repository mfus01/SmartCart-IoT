// 4. TRANG THAI BAN DO
// =====================================================

let highlightedProduct = null;

let currentRoute = null;

let cartPosition = {
    x: ENTRANCE.x,
    y: ENTRANCE.y
};

// Luu tat ca san pham trong gio hang
let cartProductsOnMap = [];


// =====================================================
// 5. KIEM TRA TOA DO
// =====================================================

function valid(point) {

    return point != null &&

        point.x != null &&

        point.y != null &&

        Number.isFinite(Number(point.x)) &&

        Number.isFinite(Number(point.y)) &&

        Number(point.x) >= 0 &&

        Number(point.x) <= 100 &&

        Number(point.y) >= 0 &&

        Number(point.y) <= 100;
}


// =====================================================
// 6. VE HINH CHU NHAT
// =====================================================

function rect(x, y, w, h, color) {

    ctx.fillStyle = color;

    ctx.fillRect(
        px(x),
        py(y),
        pw(w),
        ph(h)
    );
}


// =====================================================
// 7. VE MARKER
// =====================================================

function marker(x, y, color, label, radius = 8) {

    ctx.beginPath();

    ctx.arc(
        px(x),
        py(y),
        radius,
        0,
        Math.PI * 2
    );

    ctx.fillStyle = color;
    ctx.fill();

    ctx.strokeStyle = "#ffffff";
    ctx.lineWidth = 2;
    ctx.stroke();

    ctx.fillStyle = "#ffffff";
    ctx.font = "bold 11px Arial";

    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    ctx.fillText(
        String(label),
        px(x),
        py(y)
    );
}


// =====================================================
// 8. VE NEN BAN DO
// =====================================================

function drawBackground() {

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    rect(
        0,
        0,
        100,
        100,
        "#f5f8f6"
    );

    ctx.strokeStyle = "#e3eae5";
    ctx.lineWidth = 1;

    for (let i = 0; i <= 100; i += 5) {

        ctx.beginPath();
        ctx.moveTo(px(i), 0);
        ctx.lineTo(px(i), canvas.height);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(0, py(i));
        ctx.lineTo(canvas.width, py(i));
        ctx.stroke();
    }

    ctx.strokeStyle = "#8a9b91";
    ctx.lineWidth = 3;

    ctx.strokeRect(
        2,
        2,
        canvas.width - 4,
        canvas.height - 4
    );
}


// =====================================================
// 9. VE LOI DI
// =====================================================

function drawAisles() {

