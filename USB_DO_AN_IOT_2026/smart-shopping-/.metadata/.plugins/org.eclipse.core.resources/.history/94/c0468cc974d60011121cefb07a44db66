// ======================================================
// MAIN MODULE
// Diem khoi dong cua Web UI
// ======================================================

import {
    getAllProducts
} from "./api/productApi.js";

import {
    drawSupermarketMap
} from "./map/map.js";

import {
    initChat
} from "./chat/chat.js";

import {
    renderCart
} from "./cart/cart.js";

import {
    initRoute
} from "./route/route.js";


// ======================================================
// LOAD DANH SACH SAN PHAM
// ======================================================

async function loadProducts() {

    try {

        const result =
            await getAllProducts();

        if (!result.success) {

            console.error(
                "Khong the lay danh sach san pham:",
                result.message
            );

            return;
        }

        console.log(
            "Danh sach san pham tu Backend:",
            result.data
        );

    } catch (error) {

        console.error(
            "Loi khi goi API /api/products:",
            error
        );
    }
}


// ======================================================
// KHOI DONG APP
// ======================================================

async function initApp() {

    console.log(
        "Khoi dong Smart Shopping Cart..."
    );

    drawSupermarketMap();

    renderCart();

    initChat();

    initRoute();

    await loadProducts();

    console.log(
        "Smart Shopping Cart da san sang."
    );
}

initApp();
// ========================================
// KET NOI ESP32 VOI WEBSITE
// ========================================

const ESP32_URL = "http://192.168.88.206/status";

const esp32Panel = document.createElement("div");

esp32Panel.style.cssText = `
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: #ffffff;
    padding: 15px;
    border-radius: 10px;
    box-shadow: 0 0 10px #999;
    z-index: 9999;
    font-family: Arial;
`;

esp32Panel.textContent = "ESP32 dang ket noi...";

document.body.appendChild(esp32Panel);

// DOC DU LIEU TU ESP32
async function updateESP32() {

    try {

        const response = await fetch(
            ESP32_URL,
            { cache: "no-store" }
        );

        if (!response.ok) {
            throw new Error("ESP32 khong phan hoi");
        }

        const data = await response.json();

        esp32Panel.innerHTML = `
            <h3>🛒 Xe day thong minh</h3>
            <p>ESP32: Da ket noi</p>
            <p>Cam bien: AS5600</p>
            <p>Goc quay:
                <b id="esp32Angle"></b>
            </p>
        `;

        document.getElementById("esp32Angle")
            .textContent = Number(data.angle).toFixed(2) + "°";

        console.log("ESP32:", data);

    } catch (error) {

        esp32Panel.textContent =
            "ESP32: Mat ket noi";

        console.error(error);
    }
}

// CAP NHAT MOI 1 GIAY
updateESP32();

setInterval(updateESP32, 1000);