    /**
     * Lay san pham tu SQLite.
     *
     * Moi nhom san pham lay toi da 2 quy cach co gia thap
     * trong 30 nhom ten san pham dau tien cua moi danh muc.
     * Cach nay giup Gemini biet nhieu loai hang ma khong can
     * gui ca 3000 dong san pham vao moi yeu cau.
     */
    private String loadProductCatalog() throws IOException {

        String sql = """
                WITH normalized AS (
                    SELECT
                        id,
                        name,
                        category,
                        price,
                        shelf_id,
                        x_coord,
                        y_coord,

                        CASE
                            WHEN instr(name, ' - ') > 0
                            THEN trim(
                                substr(name, 1, instr(name, ' - ') - 1)
                            )
                            ELSE trim(name)
                        END AS base_name,

                        ROW_NUMBER() OVER (
                            PARTITION BY
                                category,
                                CASE
                                    WHEN instr(name, ' - ') > 0
                                    THEN trim(
                                        substr(
                                            name,
                                            1,
                                            instr(name, ' - ') - 1
                                        )
                                    )
                                    ELSE trim(name)
                                END
                            ORDER BY price ASC, name ASC
                        ) AS variant_rank,

                        DENSE_RANK() OVER (
                            PARTITION BY category
                            ORDER BY
                                CASE
                                    WHEN instr(name, ' - ') > 0
                                    THEN trim(
                                        substr(
                                            name,
                                            1,
                                            instr(name, ' - ') - 1
                                        )
                                    )
                                    ELSE trim(name)
                                END
                        ) AS base_rank

                    FROM Products
                    WHERE price > 0
                )

                SELECT
                    id,
                    name,
                    category,
                    price,
                    shelf_id,
                    x_coord,
                    y_coord

                FROM normalized

                WHERE variant_rank <= 2
                  AND base_rank <= 30

                ORDER BY category, base_name, price
                """;

        StringBuilder catalog = new StringBuilder();

        try (Connection connection =
                     databaseConnection.getConnection();

             PreparedStatement statement =
                     connection.prepareStatement(sql);

             ResultSet resultSet = statement.executeQuery()) {

            while (resultSet.next()) {

                catalog.append("- Ma: ")
                        .append(resultSet.getString("id"));

                catalog.append(" | Ten: ")
                        .append(resultSet.getString("name"));

                catalog.append(" | Danh muc: ")
                        .append(resultSet.getString("category"));

                catalog.append(" | Gia: ")
                        .append(resultSet.getLong("price"))
                        .append(" VND");

                catalog.append(" | Ke: ")
                        .append(resultSet.getString("shelf_id"));

                catalog.append(" | Toa do: (")
                        .append(resultSet.getString("x_coord"))
                        .append(", ")
                        .append(resultSet.getString("y_coord"))
                        .append(")");

                catalog.append("\n");
            }

        } catch (SQLException e) {

            System.err.println(
                    "Khong doc duoc danh muc SQLite: "
                    + e.getMessage()
            );

            throw new IOException(
                    "Khong the doc danh muc san pham tu SQLite. "
                    + "Hay kiem tra duong dan database va bang Products.",
                    e
            );
        }

        if (catalog.isEmpty()) {
            throw new IOException(
                    "Danh muc SQLite khong co san pham hop le."
            );
        }

        return catalog.toString();
    }
}