import { searchProducts } from "../api/productApi.js";
import { highlightProductOnMap } from "../map/map.js";
import { addToCart } from "../cart/cart.js";

// ======================================================
// DOM
// ======================================================

const chatInput = document.getElementById("chatInput");
const sendButton = document.getElementById("sendButton");
const chatMessages = document.getElementById("chatMessages");

// ======================================================
// CHUAN HOA CHUOI TIENG VIET
// Chuyen chu co dau thanh chu khong dau de xu ly tu khoa
// ======================================================

function normalizeText(message) {
return String(message ?? "")
.normalize("NFD")
.replace(/[\u0300-\u036f]/g, "")
.replace(/đ/g, "d")
.replace(/Đ/g, "D")
.toLowerCase()
.trim();
}

// ======================================================
// TACH TU KHOA SAN PHAM
// Vi du: "ca rot o dau" -> "ca rot"
// ======================================================

function extractProductKeyword(message) {
let keyword = normalizeText(message)
.replace(/[?!.,;:]/g, " ")
.replace(/\s+/g, " ")
.trim();

const phrasesToRemove = [
    "cho toi biet",
    "giup toi tim",
    "tim kiem san pham",
    "tim san pham",
    "toi muon mua",
    "toi can mua",
    "nam o dau",
    "o dau",
    "ke nao",
    "vi tri",
    "bao nhieu tien",
    "gia bao nhieu",
    "toi muon",
    "toi can",
    "hay tim",
    "tim kiem",
    "san pham",
    "mua",
    "tim",
    "gia"
];

phrasesToRemove.sort((a, b) => b.length - a.length);

for (const phrase of phrasesToRemove) {
    const escapedPhrase = phrase.replace(
        /[.*+?^${}()|[\]\\]/g,
        "\\$&"
    );

    keyword = keyword.replace(
        new RegExp("\\b" + escapedPhrase + "\\b", "g"),
        " "
    );
}

return keyword.replace(/\s+/g, " ").trim();

}

// ======================================================
// THEM TIN NHAN VAO CHAT
// ======================================================

function addChatMessage(message, type) {
if (!chatMessages) {
console.error("Khong tim thay phan tu chatMessages.");
return;
}

const messageElement = document.createElement("p");

messageElement.textContent = message;
messageElement.classList.add("chat-message");

if (type === "user") {
    messageElement.style.background = "#1565c0";
    messageElement.style.color = "white";
} else {
    messageElement.style.background = "#e3f2fd";
    messageElement.style.color = "#222";
}

messageElement.style.padding = "12px";
messageElement.style.borderRadius = "8px";
messageElement.style.marginBottom = "10px";

chatMessages.appendChild(messageElement);
chatMessages.scrollTop = chatMessages.scrollHeight;

}

// ======================================================
// XOA KET QUA TIM KIEM CU
// Khong xoa tin nhan va thong bao gio hang
// ======================================================

function clearPreviousSearchResults() {
if (!chatMessages) {
return;
}

const oldResults = chatMessages.querySelectorAll(".product-result");

oldResults.forEach(result => {
    result.remove();
});

}

// ======================================================
// HIEN THI SAN PHAM TIM DUOC
// ======================================================

function addProductResultMessage(product) {
const container = document.createElement("div");

container.classList.add("product-result");

container.style.background = "#e3f2fd";
container.style.color = "#222";
container.style.padding = "12px";
container.style.marginBottom = "10px";
container.style.borderRadius = "8px";

const textElement = document.createElement("div");

const price = Number(product.price);

textElement.textContent =
    "Tim thay: " +
    product.name +
    " | Gia: " +
    (Number.isFinite(price)
        ? price.toLocaleString("vi-VN")
        : "Chua co gia") +
    " VND" +
    " | Ke " +
    (product.shelfId ?? "Chua xac dinh") +
    " | Toa do: (" +
    (product.xCoord ?? "?") +
    ", " +
    (product.yCoord ?? "?") +
    ")";

// Nut them vao gio hang
const addButton = document.createElement("button");

addButton.textContent = "Them vao gio";

addButton.style.marginTop = "10px";
addButton.style.padding = "8px 12px";
addButton.style.border = "none";
addButton.style.borderRadius = "6px";
addButton.style.background = "#2e7d32";
addButton.style.color = "white";
addButton.style.cursor = "pointer";

addButton.addEventListener("click", function () {
    try {
        addToCart(product);

        addChatMessage(
            "Da them " + product.name + " vao gio hang.",
            "bot"
        );
    } catch (error) {
        console.error("Loi them san pham vao gio:", error);

        addChatMessage(
            "Khong the them san pham vao gio hang.",
            "bot"
        );
    }
});

container.appendChild(textElement);
container.appendChild(addButton);

chatMessages.appendChild(container);
chatMessages.scrollTop = chatMessages.scrollHeight;

}

// ======================================================
// TIM SAN PHAM
// ======================================================

async function handleSearchProduct(message) {
// Xoa ket qua cu khi bat dau tim kiem moi
clearPreviousSearchResults();

const searchKeyword = extractProductKeyword(message) || message;

console.log("Cau nguoi dung:", message);
console.log("Tu khoa tim kiem:", searchKeyword);

try {
    const result = await searchProducts(searchKeyword);

    if (!result || !result.success) {
        addChatMessage(
            result?.message || "Khong tim thay san pham.",
            "bot"
        );
        return;
    }

    const products = Array.isArray(result.data)
        ? result.data
        : [];

    if (products.length === 0) {
        addChatMessage(
            "Khong tim thay san pham phu hop.",
            "bot"
        );
        return;
    }

    // Danh dau san pham dau tien tren ban do
    highlightProductOnMap(products[0]);

    // Hien thi ket qua cua lan tim kiem hien tai
    products.forEach(product => {
        addProductResultMessage(product);
    });

} catch (error) {
    console.error("Loi tim san pham:", error);

    addChatMessage(
        "Khong the ket noi den Backend. Vui long thu lai.",
        "bot"
    );
}

}

// ======================================================
// GUI TIN NHAN
// ======================================================

let isSending = false;

async function handleSendMessage() {
if (!chatInput || !sendButton || !chatMessages) {
console.error("Khong tim thay cac phan tu giao dien chat.");
return;
}

if (isSending) {
    return;
}

const message = chatInput.value.trim();

if (message === "") {
    return;
}

// Hien thi tin nhan nguoi dung
addChatMessage(message, "user");

chatInput.value = "";
isSending = true;
sendButton.disabled = true;

try {
    await handleSearchProduct(message);
} finally {
    isSending = false;
    sendButton.disabled = false;
    chatInput.focus();
}

}

// ======================================================
// KHOI DONG CHAT
// ======================================================

export function initChat() {
if (!chatInput || !sendButton || !chatMessages) {
console.error(
"Khong the khoi dong chat: thieu phan tu HTML."
);
return;
}

// Gan su kien click cho nut Gui
sendButton.removeEventListener("click", handleSendMessage);
sendButton.addEventListener("click", handleSendMessage);

// Enter de gui tin nhan
chatInput.addEventListener("keydown", function (event) {
    if (event.key === "Enter" && !event.isComposing) {
        event.preventDefault();
        handleSendMessage();
    }
});

console.log("Chat module da khoi dong.");

}