// ======================================================
// CUA VAO VA QUAY THANH TOAN
// ======================================================

const ENTRANCE = {
    x: 8,
    y: 91,
    label: "CUA VAO"
};

const CHECKOUTS = [
    { id: "Q1", x: 76, y: 91, label: "QUAY 1" },
    { id: "Q2", x: 86, y: 91, label: "QUAY 2" },
    { id: "Q3", x: 96, y: 91, label: "QUAY 3" }
];

// ======================================================
// TRANG THAI BAN DO
// ======================================================

let highlightedProduct = null;
let currentRoute = null;

// Vi tri xe day MO PHONG
// Chua phai vi tri do ESP32 tinh toan

let cartPosition = {
    x: ENTRANCE.x,
    y: ENTRANCE.y
};

// ======================================================
// CHUYEN TOA DO SANG PIXEL
// ======================================================

const px = x => Number(x) / W * canvas.width;
const py = y => Number(y) / H * canvas.height;
const pw = w => Number(w) / W * canvas.width;
const ph = h => Number(h) / H * canvas.height;

// ======================================================
// KIEM TRA TOA DO
// ======================================================

function valid(p) {
    return p &&
        Number.isFinite(Number(p.x)) &&
        Number.isFinite(Number(p.y)) &&
        Number(p.x) >= 0 &&
        Number(p.x) <= 100 &&
        Number(p.y) >= 0 &&
        Number(p.y) <= 100;
}

// ======================================================
// VE HINH CHU NHAT
// ======================================================

function rect(x, y, w, h, color) {
    ctx.fillStyle = color;

    ctx.fillRect(
        px(x),
        py(y),
        pw(w),
        ph(h)
    );
}

// ======================================================
// VE MARKER
// ======================================================

function marker(x, y, color, label) {

    ctx.beginPath();

    ctx.arc(
        px(x),
        py(y),
        8,
        0,
        Math.PI * 2
    );

    ctx.fillStyle = color;
    ctx.fill();

    ctx.strokeStyle = "#fff";
    ctx.lineWidth = 2;
    ctx.stroke();

    ctx.fillStyle = "#fff";
    ctx.font = "bold 11px Arial";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    ctx.fillText(
        label,
        px(x),
        py(y)
    );
}

// ======================================================
// VE NEN BAN DO
// ======================================================

function drawBackground() {

    rect(0, 0, 100, 100, C.background);

    ctx.strokeStyle = C.grid;
    ctx.lineWidth = 1;

    for (let i = 0; i <= 100; i += 5) {

        ctx.beginPath();
        ctx.moveTo(px(i), 0);
        ctx.lineTo(px(i), canvas.height);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(0, py(i));
        ctx.lineTo(canvas.width, py(i));
        ctx.stroke();
    }

    ctx.strokeStyle = C.border;
    ctx.lineWidth = 3;

    ctx.strokeRect(
        2,
        2,
        canvas.width - 4,
        canvas.height - 4
    );
}

// ======================================================
// VE LOI DI
// ======================================================

function drawAisles() {

    [
        { y: 11, h: 3 },
        { y: 30, h: 4 },
        { y: 49, h: 4 },
        { y: 68, h: 4 },
        { y: 79, h: 3 }
    ].forEach(a =>
        rect(2, a.y, 96, a.h, C.aisle)
    );

    [12, 24, 36, 48, 60, 72, 84]
        .forEach(x =>
            rect(x, 14, 3, 64, C.aisle)
        );

    rect(2, 82, 96, 7, C.mainAisle);

    ctx.strokeStyle = C.aisleBorder;
    ctx.lineWidth = 1.5;

    ctx.strokeRect(
        px(2),
        py(14),
        pw(96),
        ph(64)
    );
}

// ======================================================
// VE TEN KHU VUC
// ======================================================

function drawZoneLabels() {

    zones.forEach((z, i) => {

        const x = shelfColumns[i] + 3.5;

        rect(
            shelfColumns[i] - 1,
            2.5,
            9,
            6.5,
            z.color
        );

        ctx.fillStyle = C.text;
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";

        ctx.font = "bold 18px Arial";
        ctx.fillText(z.id, px(x), py(6) - 7);

        ctx.font = "bold 15px Arial";
        ctx.fillText(z.name, px(x), py(6) + 9);
    });
}

// ======================================================
// VE KE HANG
// ======================================================

function drawShelf(s) {

    ctx.fillStyle = "rgba(38,50,56,.15)";

    ctx.fillRect(
        px(s.x) + 3,
        py(s.y) + 3,
        pw(s.width),
        ph(s.height)
    );

    rect(
        s.x,
        s.y,
        s.width,
        s.height,
        s.color
    );

    ctx.strokeStyle = C.shelfBorder;
    ctx.lineWidth = 2;

    ctx.strokeRect(
        px(s.x),
        py(s.y),
        pw(s.width),
        ph(s.height)
    );

    ctx.strokeStyle = "rgba(38,50,56,.2)";
    ctx.lineWidth = 1;

    for (let i = 1; i < 4; i++) {

        const x = px(s.x) + pw(s.width) * i / 4;

        ctx.beginPath();
        ctx.moveTo(x, py(s.y) + 3);
        ctx.lineTo(x, py(s.y + s.height) - 3);
        ctx.stroke();
    }

    ctx.fillStyle = C.text;
    ctx.font = "bold 18px Arial";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    ctx.fillText(
        s.label,
        px(s.x + s.width / 2),
        py(s.y + s.height / 2)
    );
}

// ======================================================
// VE DIEM TIEP CAN KE
// ======================================================

function drawAccess(s) {

    ctx.beginPath();

    ctx.moveTo(
        px(s.accessX),
        py(s.y + s.height)
    );

    ctx.lineTo(
        px(s.accessX),
        py(s.accessY)
    );

    ctx.strokeStyle = "#9eaaa3";
    ctx.lineWidth = 1.5;
    ctx.stroke();

    ctx.beginPath();

    ctx.arc(
        px(s.accessX),
        py(s.accessY),
        5,
        0,
        Math.PI * 2
    );

    ctx.fillStyle = C.access;
    ctx.fill();

    ctx.strokeStyle = "#fff";
    ctx.lineWidth = 2;
    ctx.stroke();
}

// ======================================================
// VE CUA VAO
// ======================================================

function drawEntrance() {

    rect(
        ENTRANCE.x - 4,
        ENTRANCE.y - 3,
        8,
        5,
        "#c8e6c9"
    );

    ctx.strokeStyle = "#2e7d32";
    ctx.lineWidth = 2;

    ctx.strokeRect(
        px(ENTRANCE.x - 4),
        py(ENTRANCE.y - 3),
        pw(8),
        ph(5)
    );

    ctx.fillStyle = "#1b5e20";
    ctx.font = "bold 13px Arial";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    ctx.fillText(
        "CUA VAO",
        px(ENTRANCE.x),
        py(ENTRANCE.y) - ph(.5)
    );

    marker(
        ENTRANCE.x,
        ENTRANCE.y,
        C.start,
        "S"
    );
}

// ======================================================
// VE QUAY THANH TOAN
// ======================================================

function drawCheckouts() {

    CHECKOUTS.forEach(q => {

        rect(
            q.x - 4,
            q.y - 3,
            8,
            5,
            "#ffe0b2"
        );

        ctx.strokeStyle = "#ef6c00";
        ctx.lineWidth = 2;

        ctx.strokeRect(
            px(q.x - 4),
            py(q.y - 3),
            pw(8),
            ph(5)
        );

        ctx.fillStyle = "#e65100";
        ctx.font = "bold 12px Arial";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";

        ctx.fillText(
            q.label,
            px(q.x),
            py(q.y) - ph(.5)
        );
    });
}

// ======================================================
// TIM KE HANG
// ======================================================

function findShelf(id) {

    if (id === null || id === undefined) {
        return null;
    }

    let key = String(id)
        .trim()
        .toUpperCase();

    if (/^[A-H]$/.test(key)) {
        key += "1";
    }

    return shelves.find(
        s => s.id === key
    ) || null;
}

// ======================================================
// DANH DAU SAN PHAM
// ======================================================

function drawProductHighlight(product) {

    const shelf = findShelf(product.shelfId);

    const point = shelf
        ? {
            x: shelf.accessX,
            y: shelf.accessY
        }
        : {
            x: Number(product.xCoord),
            y: Number(product.yCoord)
        };

    if (!valid(point)) {
        return;
    }

    ctx.beginPath();

    ctx.arc(
        px(point.x),
        py(point.y),
        13,
        0,
        Math.PI * 2
    );

    ctx.strokeStyle = C.highlight;
    ctx.lineWidth = 5;
    ctx.stroke();

    if (shelf) {

        ctx.strokeRect(
            px(shelf.x) - 4,
            py(shelf.y) - 4,
            pw(shelf.width) + 8,
            ph(shelf.height) + 8
        );
    }

    const name = String(
        product.name ?? "San pham"
    ).trim();

    const shelfText = shelf
        ? "Ke " + shelf.id
        : "Chua xac dinh ke";

    ctx.font = "bold 18px Arial";

    const width = Math.max(
        ctx.measureText(name).width,
        ctx.measureText(shelfText).width
    ) + 16;

    const x = Math.max(
        5,
        Math.min(
            px(point.x) + 15,
            canvas.width - width - 5
        )
    );

    const y = Math.max(
        5,
        Math.min(
            py(point.y) - 45,
            canvas.height - 45
        )
    );

    ctx.fillStyle = "rgba(255,248,225,.97)";
    ctx.fillRect(x, y, width, 42);

    ctx.strokeStyle = C.highlight;
    ctx.lineWidth = 1.5;
    ctx.strokeRect(x, y, width, 42);

    ctx.fillStyle = "#bf360c";
    ctx.textAlign = "left";
    ctx.textBaseline = "top";

    ctx.font = "bold 18px Arial";
    ctx.fillText(name, x + 8, y + 3);

    ctx.fillStyle = "#37474f";
    ctx.font = "bold 14px Arial";

    ctx.fillText(
        shelfText,
        x + 8,
        y + 24
    );
}

// ======================================================
// VE TUYEN DUONG
// ======================================================

function drawRouteOverlay(points) {

    if (!Array.isArray(points) || points.length < 2) {
        return;
    }

    const good = points.filter(valid);

    if (good.length < 2) {
        return;
    }

    ctx.beginPath();

    good.forEach((p, i) => {

        if (i === 0) {
            ctx.moveTo(px(p.x), py(p.y));
        } else {
            ctx.lineTo(px(p.x), py(p.y));
        }
    });

    ctx.strokeStyle = C.route;
    ctx.lineWidth = 5;
    ctx.lineCap = "round";
    ctx.lineJoin = "round";

    ctx.setLineDash([12, 8]);
    ctx.stroke();
    ctx.setLineDash([]);

    marker(
        good[0].x,
        good[0].y,
        C.start,
        "S"
    );

    marker(
        good[good.length - 1].x,
        good[good.length - 1].y,
        C.end,
        "F"
    );
}

// ======================================================
// VE TOAN BO BAN DO
// ======================================================

export function drawSupermarketMap() {

    drawBackground();
    drawAisles();
    drawZoneLabels();

    shelves.forEach(drawShelf);
    shelves.forEach(drawAccess);

    drawEntrance();
    drawCheckouts();

    if (highlightedProduct) {
        drawProductHighlight(highlightedProduct);
    }

    if (currentRoute) {
        drawRouteOverlay(currentRoute);
    }

    // VE VI TRI XE DAY SAU CUNG
    if (valid(cartPosition)) {

        marker(
            cartPosition.x,
            cartPosition.y,
            "#1565c0",
            "X"
        );
    }
}

// ======================================================
// VE LO TRINH BACKEND TRA VE
// ======================================================

export function drawRoute(points) {

    const good = Array.isArray(points)
        ? points
            .filter(valid)
            .map(p => ({
                x: Number(p.x),
                y: Number(p.y)
            }))
        : [];

    currentRoute = good.length >= 2
        ? good
        : null;

    if (!currentRoute) {
        console.warn("Route khong hop le:", points);
    }

    drawSupermarketMap();
}

