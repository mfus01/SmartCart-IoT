// Danh sach san pham dang co trong gio
let cartProductsOnMap = [];

// ======================================================
// 1. NHOM SAN PHAM THEO KE HANG
// ======================================================

function getCartShelfGroups() {

    const groups = [];

    const groupMap = new Map();

    cartProductsOnMap.forEach(product => {

        if (!product || !product.name) {
            return;
        }

        // Tim ke hang
        const shelf = findShelf(product.shelfId);

        // Xac dinh diem danh dau
        let point = null;

        if (shelf) {

            point = {
                x: shelf.accessX,
                y: shelf.accessY
            };

        } else if (
            product.xCoord != null &&
            product.yCoord != null
        ) {

            point = {
                x: Number(product.xCoord),
                y: Number(product.yCoord)
            };
        }

        if (!valid(point)) {
            return;
        }

        // Moi ke chi tao mot nhom
        const key = shelf
            ? shelf.id
            : point.x + ":" + point.y;

        if (!groupMap.has(key)) {

            const group = {

                index: groups.length + 1,

                shelf: shelf,

                x: point.x,

                y: point.y,

                products: []

            };

            groupMap.set(key, group);

            groups.push(group);
        }

        groupMap.get(key).products.push(product);
    });

    return groups;
}


// ======================================================
// 2. VE DAU DANH SAN PHAM TREN BAN DO
// ======================================================

function drawCartMarkers() {

    const groups = getCartShelfGroups();

    groups.forEach(group => {

        const shelf = group.shelf;

        ctx.save();

        // ==========================================
        // TO VIEN CAM QUANH KE
        // ==========================================

        if (shelf) {

            const x = px(shelf.x);

            const y = py(shelf.y);

            const width = pw(shelf.width);

            const height = ph(shelf.height);

            ctx.strokeStyle = "#ff9800";

            ctx.lineWidth = 4;

            ctx.strokeRect(
                x - 3,
                y - 3,
                width + 6,
                height + 6
            );
        }

        // ==========================================
        // VE HUY HIEU SO TAI DIEM TIEP CAN KE
        // ==========================================

        const markerX = px(group.x);

        const markerY = py(group.y);

        // Vien mau cam
        ctx.beginPath();

        ctx.arc(
            markerX,
            markerY,
            12,
            0,
            Math.PI * 2
        );

        ctx.fillStyle = "#fff8e1";

        ctx.fill();

        ctx.strokeStyle = "#ef6c00";

        ctx.lineWidth = 3;

        ctx.stroke();

        // ==========================================
        // SO THU TU KE TRONG DANH SACH
        // ==========================================

        ctx.fillStyle = "#bf360c";

        ctx.font = "bold 13px Arial";

        ctx.textAlign = "center";

        ctx.textBaseline = "middle";

        ctx.fillText(
            String(group.index),
            markerX,
            markerY
        );

        ctx.restore();
    });
}


// ======================================================
// 3. TAO BANG DANH SACH KE CAN GHE
// ======================================================

function updateCartMapLegend() {

    let legend = document.getElementById(
        "cartMapLegend"
    );

    // Chi tao bang mot lan
    if (!legend) {

        legend = document.createElement("div");

        legend.id = "cartMapLegend";

        legend.style.cssText = `
            margin-top: 12px;
            padding: 12px;
            background: #fff8e1;
            border: 1px solid #ffcc80;
            border-radius: 8px;
            font-family: Arial, sans-serif;
            font-size: 13px;
            max-height: 170px;
            overflow-y: auto;
            box-sizing: border-box;
        `;

        // Chen ngay duoi canvas
        canvas.insertAdjacentElement(
            "afterend",
            legend
        );
    }

    // Xoa noi dung cu
    legend.replaceChildren();

    const groups = getCartShelfGroups();

    // Gio hang rong
    if (groups.length === 0) {

        legend.style.display = "none";

        return;
    }

    legend.style.display = "block";

    // ==========================================
    // TIEU DE
    // ==========================================

    const title = document.createElement("div");

    title.textContent =
        "🛒 Các kệ cần ghé (" +
        groups.length +
        ")";

    title.style.cssText = `
        font-weight: bold;
        font-size: 15px;
        margin-bottom: 10px;
        color: #e65100;
    `;

    legend.appendChild(title);

    // ==========================================
    // DANH SACH KE
    // ==========================================

    groups.forEach(group => {

        const row = document.createElement("div");

        row.style.cssText = `
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 7px 0;
            border-bottom: 1px solid #ffe0b2;
        `;

        // Huy hieu so
        const badge = document.createElement("span");

        badge.textContent = String(group.index);

        badge.style.cssText = `
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 25px;
            height: 25px;
            border-radius: 50%;
            background: #ef6c00;
            color: white;
            font-weight: bold;
            flex-shrink: 0;
        `;

        // Thong tin san pham
        const details = document.createElement("div");

        const shelfName = group.shelf
            ? "Kệ " + group.shelf.id
            : "Vị trí (" +
                group.x + ", " + group.y + ")";

        const shelfTitle = document.createElement("strong");

        shelfTitle.textContent = shelfName;

        const productNames = document.createElement("div");

        productNames.style.cssText = `
            margin-top: 4px;
            color: #37474f;
            line-height: 1.5;
            overflow-wrap: anywhere;
        `;

        productNames.textContent =
            group.products.map(product => {

                const quantity = Number(
                    product.quantity
                ) || 1;

                return product.name +
                    " (x" + quantity + ")";

            }).join(", ");

        details.appendChild(shelfTitle);

        details.appendChild(productNames);

        row.appendChild(badge);

        row.appendChild(details);

        legend.appendChild(row);
    });
}


// ======================================================
// 4. NHAN DANH SACH SAN PHAM TU GIO HANG
// ======================================================

export function setCartProductsOnMap(products) {

    if (!Array.isArray(products)) {

        cartProductsOnMap = [];

    } else {

        cartProductsOnMap = products.map(
            product => ({ ...product })
        );
    }

    console.log(
        "[MAP] San pham trong gio:",
        cartProductsOnMap
    );

    // Cap nhat danh sach ke
    updateCartMapLegend();

    // Ve lai ban do
    drawSupermarketMap();
}

