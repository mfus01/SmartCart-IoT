package com.smartcart.controller;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.Comparator;
import java.util.HashMap;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.PriorityQueue;
import java.util.Set;

import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.smartcart.dto.ApiResponse;
import com.smartcart.dto.RoutePoint;
import com.smartcart.dto.RouteProductRequest;
import com.smartcart.dto.RouteRequest;
import com.smartcart.dto.RouteResponse;

@RestController
@RequestMapping("/api")
public class RouteController {

    // =====================================================
    // 1. CAU HINH BAN DO
    // =====================================================

    // He toa do logic 0..100

    private static final int MIN_X = 2;
    private static final int MAX_X = 98;

    private static final int MIN_Y = 12;
    private static final int MAX_Y = 91;

    private static final int INF = 1_000_000;

    // Toa do goc trai cua 8 cot ke

    private static final int[] SHELF_LEFT = {
        4, 16, 28, 40, 52, 64, 76, 88
    };

    // Toa do phia tren cua 3 hang ke

    private static final int[] SHELF_TOP = {
        18, 37, 56
    };

    // Toa do tiep can ke
    // Lam tron de phu hop RoutePoint int

    private static final int[] ACCESS_X = {
        8, 20, 32, 44, 56, 68, 80, 92
    };

    private static final int[] ACCESS_Y = {
        30, 49, 68
    };

    // Bon huong di chuyen

    private static final int[][] DIRECTIONS = {
        {1, 0},
        {0, 1},
        {-1, 0},
        {0, -1}
    };


    // =====================================================
    // 2. API TAO LO TRINH
    // =====================================================

    @PostMapping("/generate-route")
    public ApiResponse<RouteResponse> generateRoute(
            @RequestBody RouteRequest request) {

        // Kiem tra request

        if (request == null
                || request.getStartPoint() == null) {

            return error(
                "Thieu vi tri bat dau cua xe"
            );
        }

        if (request.getProducts() == null
                || request.getProducts().isEmpty()) {

            return error(
                "Gio hang dang rong"
            );
        }

        // Lay vi tri hien tai cua xe

        RoutePoint start = new RoutePoint(
                request.getStartPoint().getX(),
                request.getStartPoint().getY()
        );

        // Kiem tra vi tri xe

        if (!isWalkable(
                start.getX(),
                start.getY())) {

            return error(
                "Vi tri xe khong nam tren loi di. "
                + "Hay chon Ve cua vao."
            );
        }

        // =================================================
        // LAY DANH SACH KE CAN GHE
        // =================================================

        Set<String> shelfIds =
                new LinkedHashSet<>();

        for (RouteProductRequest product
                : request.getProducts()) {

            if (product == null
                    || product.getShelfId() == null) {

                continue;
            }

            String id = product.getShelfId()
                    .trim()
                    .toUpperCase(Locale.ROOT);

            // Tuong thich ma ke cu A..H

            if (id.matches("[A-H]")) {
                id += "1";
            }

            if (getShelfPoint(id) != null) {

                // Neu trung ke thi chi ghe mot lan
                // Lan xuat hien cuoi quyet dinh vi tri

                shelfIds.remove(id);
                shelfIds.add(id);
            }
        }

        if (shelfIds.isEmpty()) {

            return error(
                "Khong tim thay ma ke hop le "
                + "trong gio hang"
            );
        }

        // =================================================
        // XAC DINH KE CUOI CUNG
        // =================================================

        List<String> ids =
                new ArrayList<>(shelfIds);

        // San pham cuoi trong gio la diem ket thuc

        String finalShelfId =
                ids.remove(ids.size() - 1);

        RoutePoint end =
                getShelfPoint(finalShelfId);

        // Cac ke trung gian can ghe

        List<RoutePoint> middle =
                new ArrayList<>();

        for (String id : ids) {

            middle.add(
                getShelfPoint(id)
            );
        }

        // =================================================
        // BO NHO DEM DUONG DI
        // =================================================

        Map<String, List<RoutePoint>> cache =
                new HashMap<>();

        // =================================================
        // TOI UU THU TU GHE KE
        // =================================================

        List<RoutePoint> order;

        if (middle.size() <= 10) {

            // Tim thu tu ngan nhat chinh xac

            order = bestOrderExact(
                    start,
                    middle,
                    end,
                    cache
            );

        } else {

            // Toi uu gan dung voi nhieu ke

            order = bestOrderHeuristic(
                    start,
                    middle,
                    end,
                    cache
            );
        }

        if (order == null) {

            return error(
                "Khong tim thay duong di den "
                + "mot hoac nhieu ke hang"
            );
        }

        // Bat buoc ket thuc tai san pham cuoi

        order.add(end);

        // =================================================
        // TAO DUONG DI A* GIUA CAC KE
        // =================================================

        List<RoutePoint> route =
                new ArrayList<>();

        addPoint(route, start);

        RoutePoint current = start;

        for (RoutePoint target : order) {

            List<RoutePoint> segment =
                    shortestPath(
                            current,
                            target,
                            cache
                    );

            if (segment == null) {

                return error(
                    "Khong tim thay duong di "
                    + "tranh ke hang"
                );
            }

            // Chi giu diem re va diem dung

            appendTurnPoints(
                    route,
                    segment
            );

            current = target;
        }

        // Frontend can it nhat 2 diem

        if (route.size() == 1) {

            route.add(
                new RoutePoint(
                    end.getX(),
                    end.getY()
                )
            );
        }

        // =================================================
        // TRA KET QUA CHO WEBSITE
        // =================================================

        RouteResponse response =
                new RouteResponse(route);

        return new ApiResponse<>(
                true,
                "Da tao lo trinh. Ket thuc tai ke "
                        + finalShelfId,
                response
        );
    }


    // =====================================================
    // 3. THONG BAO LOI
    // =====================================================

    private ApiResponse<RouteResponse> error(
            String message) {

        return new ApiResponse<>(
                false,
                message,
                null
        );
    }


    // =====================================================
    // 4. TIM TOA DO KE
    // =====================================================

    private RoutePoint getShelfPoint(
            String id) {

        if (id == null
                || !id.matches("[A-H][1-3]")) {

            return null;
        }

        int column =
                id.charAt(0) - 'A';

        int row =
                id.charAt(1) - '1';

        return new RoutePoint(
                ACCESS_X[column],
                ACCESS_Y[row]
        );
    }


    // =====================================================
    // 5. KIEM TRA VI TRI CO THE DI CHUYEN
    // =====================================================

    private boolean isWalkable(
            int x,
            int y) {

        // Khong di ra ngoai pham vi

        if (x < MIN_X || x > MAX_X
                || y < MIN_Y || y > MAX_Y) {

            return false;
        }

        // =================================================
        // CHAN 24 KE HANG
        // =================================================

        for (int sx : SHELF_LEFT) {

            for (int sy : SHELF_TOP) {

                // Ke rong 7, cao 10
                // Mo rong them 1 don vi an toan

                if (x >= sx - 1
                        && x <= sx + 8
                        && y >= sy - 1
                        && y <= sy + 11) {

                    return false;
                }
            }
        }

        // =================================================
        // CHAN CAC QUAY THANH TOAN
        // =================================================

        int[] checkouts = {
            76, 86, 96
        };

        for (int checkoutX : checkouts) {

            if (x >= checkoutX - 5
                    && x <= checkoutX + 5
                    && y >= 87
                    && y <= 94) {

                return false;
            }
        }

        return true;
    }


    // =====================================================
    // 6. NODE CUA THUAT TOAN A*
    // =====================================================

    private static class Node {

        final int x;
        final int y;

        final int direction;

        final int g;
        final int f;

        final Node previous;

        Node(
                int x,
                int y,
                int direction,
                int g,
                int f,
                Node previous) {

            this.x = x;
            this.y = y;

            this.direction = direction;

            this.g = g;
            this.f = f;

            this.previous = previous;
        }
    }


    // =====================================================
    // 7. THUAT TOAN TIM DUONG A*
    // =====================================================

    private List<RoutePoint> shortestPath(
            RoutePoint from,
            RoutePoint to,
            Map<String, List<RoutePoint>> cache) {

        String key =
                pointKey(from)
                + ">"
                + pointKey(to);

        // Kiem tra duong da tinh

        if (cache.containsKey(key)) {

            return cache.get(key);
        }

        // Kiem tra duong nguoc lai

        String reverseKey =
                pointKey(to)
                + ">"
                + pointKey(from);

        if (cache.containsKey(reverseKey)) {

            List<RoutePoint> reversed =
                    cache.get(reverseKey);

            if (reversed == null) {

                cache.put(key, null);
                return null;
            }

            List<RoutePoint> path =
                    new ArrayList<>(reversed);

            Collections.reverse(path);

            cache.put(key, path);

            return path;
        }

        int sx = from.getX();
        int sy = from.getY();

        int tx = to.getX();
        int ty = to.getY();

        // Kiem tra toa do

        if (!isWalkable(sx, sy)
                || !isWalkable(tx, ty)) {

            cache.put(key, null);

            return null;
        }

        // Diem dau trung diem cuoi

        if (sx == tx && sy == ty) {

            List<RoutePoint> singleton =
                    List.of(
                        new RoutePoint(sx, sy)
                    );

            cache.put(key, singleton);

            return singleton;
        }

        // =================================================
        // CHI PHI TOT NHAT TAI MOI TRANG THAI
        // =================================================

        int[][][] best =
                new int[101][101][4];

        for (int[][] rows : best) {

            for (int[] dirs : rows) {

                Arrays.fill(dirs, INF);
            }
        }

        // Hang doi uu tien

        PriorityQueue<Node> queue =
                new PriorityQueue<>(
                    Comparator
                        .comparingInt(
                            (Node node) -> node.f
                        )
                        .thenComparingInt(
                            node -> -node.g
                        )
                );

        // Them diem bat dau

        queue.add(
            new Node(
                sx,
                sy,
                -1,
                0,
                manhattan(
                    sx, sy, tx, ty
                ) * 1000,
                null
            )
        );

        // =================================================
        // BAT DAU TIM DUONG
        // =================================================

        while (!queue.isEmpty()) {

            Node current = queue.poll();

            if (current.direction >= 0
                    && current.g !=
                    best[current.x][current.y]
                        [current.direction]) {

                continue;
            }

            // Tim thay dich

            if (current.x == tx
                    && current.y == ty) {

                List<RoutePoint> path =
                        new ArrayList<>();

                for (Node node = current;
                        node != null;
                        node = node.previous) {

                    path.add(
                        new RoutePoint(
                            node.x,
                            node.y
                        )
                    );
                }

                Collections.reverse(path);

                cache.put(key, path);

                return path;
            }

            // =================================================
            // DUYET BON HUONG
            // =================================================

            for (int direction = 0;
                    direction < 4;
                    direction++) {

                int nx =
                        current.x
                        + DIRECTIONS[direction][0];

                int ny =
                        current.y
                        + DIRECTIONS[direction][1];

                // Khong di vao ke hang

                if (!isWalkable(nx, ny)) {

                    continue;
                }

                // Chi phi re huong nho
                // Uu tien duong it goc re

                int turnCost =
                        current.direction >= 0
                        && current.direction != direction
                        ? 1
                        : 0;

                int nextG =
                        current.g
                        + 1000
                        + turnCost;

                if (nextG >=
                        best[nx][ny][direction]) {

                    continue;
                }

                best[nx][ny][direction] =
                        nextG;

                int f =
                        nextG
                        + manhattan(
                            nx, ny, tx, ty
                        ) * 1000;

                queue.add(
                    new Node(
                        nx,
                        ny,
                        direction,
                        nextG,
                        f,
                        current
                    )
                );
            }
        }

        // Khong tim thay duong

        cache.put(key, null);

        return null;
    }


    // =====================================================
    // 8. TAO KHOA TOA DO
    // =====================================================

    private String pointKey(
            RoutePoint p) {

        return p.getX()
                + ":"
                + p.getY();
    }


    // =====================================================
    // 9. KHOANG CACH MANHATTAN
    // =====================================================

    private int manhattan(
            int x1,
            int y1,
            int x2,
            int y2) {

        return Math.abs(x1 - x2)
                + Math.abs(y1 - y2);
    }


    // =====================================================
    // 10. TINH DO DAI DUONG DI
    // =====================================================

    private int distance(
            RoutePoint a,
            RoutePoint b,
            Map<String, List<RoutePoint>> cache) {

        List<RoutePoint> path =
                shortestPath(a, b, cache);

        if (path == null) {

            return INF;
        }

        return path.size() - 1;
    }


    // =====================================================
    // 11. TOI UU THU TU GHE KE CHINH XAC
    // =====================================================

    private List<RoutePoint> bestOrderExact(
            RoutePoint start,
            List<RoutePoint> middle,
            RoutePoint end,
            Map<String, List<RoutePoint>> cache) {

        int n = middle.size();

        // Khong co ke trung gian

        if (n == 0) {

            return distance(
                    start,
                    end,
                    cache
            ) >= INF
                    ? null
                    : new ArrayList<>();
        }

        int full = (1 << n) - 1;

        int[][] dp =
                new int[full + 1][n];

        int[][] parent =
                new int[full + 1][n];

        for (int i = 0; i <= full; i++) {

            Arrays.fill(dp[i], INF);
            Arrays.fill(parent[i], -1);
        }

        // Di tu vi tri xe den tung ke

        for (int i = 0; i < n; i++) {

            dp[1 << i][i] =
                    distance(
                        start,
                        middle.get(i),
                        cache
                    );
        }

        // =================================================
        // QUY HOACH DONG TOI UU THU TU KE
        // =================================================

        for (int mask = 1;
                mask <= full;
                mask++) {

            for (int last = 0;
                    last < n;
                    last++) {

                if ((mask & (1 << last)) == 0
                        || dp[mask][last] >= INF) {

                    continue;
                }

                for (int next = 0;
                        next < n;
                        next++) {

                    if ((mask & (1 << next)) != 0) {

                        continue;
                    }

                    int nextMask =
                            mask | (1 << next);

                    int cost =
                            dp[mask][last]
                            + distance(
                                middle.get(last),
                                middle.get(next),
                                cache
                            );

                    if (cost < dp[nextMask][next]) {

                        dp[nextMask][next] = cost;

                        parent[nextMask][next] =
                                last;
                    }
                }
            }
        }

        // =================================================
        // CO DINH KE CUOI CUNG
        // =================================================

        int finalCost = INF;

        int lastIndex = -1;

        for (int i = 0; i < n; i++) {

            int cost =
                    dp[full][i]
                    + distance(
                        middle.get(i),
                        end,
                        cache
                    );

            if (cost < finalCost) {

                finalCost = cost;

                lastIndex = i;
            }
        }

        if (lastIndex == -1) {

            return null;
        }

        // =================================================
        // TRUY VET THU TU GHE KE
        // =================================================

        List<RoutePoint> order =
                new ArrayList<>();

        int mask = full;

        while (lastIndex != -1) {

            order.add(
                middle.get(lastIndex)
            );

            int previous =
                    parent[mask][lastIndex];

            mask ^= 1 << lastIndex;

            lastIndex = previous;
        }

        Collections.reverse(order);

        return order;
    }


    // =====================================================
    // 12. TOI UU GAN DUNG KHI CO NHIEU KE
    // =====================================================

    private List<RoutePoint> bestOrderHeuristic(
            RoutePoint start,
            List<RoutePoint> middle,
            RoutePoint end,
            Map<String, List<RoutePoint>> cache) {

        List<RoutePoint> pending =
                new ArrayList<>(middle);

        List<RoutePoint> order =
                new ArrayList<>();

        RoutePoint current = start;

        // =================================================
        // UU TIEN KE GAN NHAT
        // =================================================

        while (!pending.isEmpty()) {

            RoutePoint best = null;

            int bestDistance = INF;

            for (RoutePoint candidate : pending) {

                int dist =
                        distance(
                            current,
                            candidate,
                            cache
                        );

                if (dist < bestDistance) {

                    best = candidate;

                    bestDistance = dist;
                }
            }

            if (best == null) {

                return null;
            }

            order.add(best);

            pending.remove(best);

            current = best;
        }

        if (distance(
                current,
                end,
                cache) >= INF) {

            return null;
        }

        // =================================================
        // DAO NGUOC CAC DOAN DE GIAM QUANG DUONG
        // =================================================

        boolean improved;

        int rounds = 0;

        do {

            improved = false;

            for (int i = 0;
                    i < order.size();
                    i++) {

                for (int j = i + 1;
                        j < order.size();
                        j++) {

                    RoutePoint before =
                            i == 0
                            ? start
                            : order.get(i - 1);

                    RoutePoint after =
                            j == order.size() - 1
                            ? end
                            : order.get(j + 1);

                    int oldDistance =
                            distance(
                                before,
                                order.get(i),
                                cache
                            )
                            + distance(
                                order.get(j),
                                after,
                                cache
                            );

                    int newDistance =
                            distance(
                                before,
                                order.get(j),
                                cache
                            )
                            + distance(
                                order.get(i),
                                after,
                                cache
                            );

                    if (newDistance < oldDistance) {

                        Collections.reverse(
                            order.subList(
                                i,
                                j + 1
                            )
                        );

                        improved = true;
                    }
                }
            }

            rounds++;

        } while (improved && rounds < 3);

        return order;
    }


    // =====================================================
    // 13. RUT GON DUONG DI
    // =====================================================

    private void appendTurnPoints(
            List<RoutePoint> route,
            List<RoutePoint> path) {

        for (int i = 0;
                i < path.size();
                i++) {

            boolean keep =
                    i == 0
                    || i == path.size() - 1;

            if (!keep) {

                RoutePoint a = path.get(i - 1);

                RoutePoint b = path.get(i);

                RoutePoint c = path.get(i + 1);

                // Giu lai diem doi huong

                keep =
                        b.getX() - a.getX()
                        != c.getX() - b.getX()

                        ||

                        b.getY() - a.getY()
                        != c.getY() - b.getY();
            }

            if (keep) {

                addPoint(
                    route,
                    path.get(i)
                );
            }
        }
    }


    // =====================================================
    // 14. THEM DIEM VA LOAI BO DIEM TRUNG
    // =====================================================

    private void addPoint(
            List<RoutePoint> route,
            RoutePoint point) {

        if (!route.isEmpty()) {

            RoutePoint last =
                    route.get(
                        route.size() - 1
                    );

            if (last.getX() == point.getX()
                    && last.getY() == point.getY()) {

                return;
            }
        }

        route.add(
            new RoutePoint(
                point.getX(),
                point.getY()
            )
        );
    }
}