function drawBlock(item, fill, stroke = "#5d7080") {
    ctx.fillStyle = "rgba(45,68,85,.16)";

    ctx.fillRect(
        px(item.x) + 4,
        py(item.y) + 4,
        pw(item.width),
        ph(item.height)
    );

    rect(
        item.x,
        item.y,
        item.width,
        item.height,
        fill
    );

    border(
        item.x,
        item.y,
        item.width,
        item.height,
        stroke,
        2
    );
}


