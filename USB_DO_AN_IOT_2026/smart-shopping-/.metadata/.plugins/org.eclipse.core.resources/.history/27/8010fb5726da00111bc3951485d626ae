// ======================================================
// DONG BO VI TRI XE TU BACKEND
// ======================================================

async function syncCartPosition() {

    try {

        const response = await fetch(
            "/api/cart-position",
            {
                cache: "no-store"
            }
        );

        if (!response.ok) {
            return;
        }

        const point = await response.json();

        if (!valid(point)) {
            return;
        }

        const x = Number(point.x);
        const y = Number(point.y);

        // Chi ve lai neu vi tri thay doi
        if (
            cartPosition.x !== x ||
            cartPosition.y !== y
        ) {

            setCartPosition({
                x: x,
                y: y
            });

        }

    } catch (error) {

        console.warn(
            "Chua dong bo duoc vi tri xe:",
            error
        );

    }
}

// Dong bo moi 1 giay
setInterval(syncCartPosition, 1000);

// Lay vi tri khi khoi dong
syncCartPosition();

