function drawWallShelves() {
    wallShelves.forEach(s => {
        drawBlock(
            s,
            "#a4c2d5",
            "#4a7488"
        );

        if (s.height > s.width) {
            ctx.save();

            ctx.translate(
                px(s.x + s.width / 2),
                py(s.y + s.height / 2)
            );

            ctx.rotate(-Math.PI / 2);

            ctx.font = "bold 14px Arial";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillStyle = "#204354";

            ctx.fillText(
                s.label,
                0,
                0,
                ph(s.height) - 16
            );

            ctx.restore();
        } else {
            textCenter(
                s.label,
                s.x + s.width / 2,
                s.y + s.height / 2,
                s.width < 15 ? 12 : 15,
                "#204354",
                pw(s.width) - 8
            );
        }
    });

    EXTRA.forEach(s => {
        drawBlock(
            s,
            "#dfd4f5",
            "#8367a8"
        );

        textCenter(
            s.label,
            s.x + s.width / 2,
            s.y + s.height / 2,
            15,
            "#4b3273"
        );
    });
}


