            "#445967"
        );

        // Chia moi ke thanh 3 khu vuc san pham
        for (let part = 1; part <= 3; part++) {
            const sub = shelves[index * 3 + part - 1];

            if (part > 1) {
                ctx.beginPath();

                ctx.moveTo(
                    px(s.x),
                    py(sub.y)
                );

                ctx.lineTo(
                    px(s.x + s.width),
                    py(sub.y)
                );

                ctx.strokeStyle = "rgba(38,50,56,.35)";
                ctx.lineWidth = 2;
                ctx.stroke();
            }

            textCenter(
                sub.id,
                sub.x + sub.width / 2,
                sub.y + sub.height / 2,
                16,
                "#153943",
                pw(sub.width) - 4
            );
        }

        textCenter(
            s.id,
            s.x + s.width / 2,
            s.y - 1.2,
            16,
            "#355161"
        );
    });
}


