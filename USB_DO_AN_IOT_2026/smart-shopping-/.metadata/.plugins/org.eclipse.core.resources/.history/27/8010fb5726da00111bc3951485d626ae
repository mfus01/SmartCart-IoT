export function drawSupermarketMap() {
    drawBackground();

    drawWallShelves();
    drawCenterShelves();
    drawDeli();
    drawCheckouts();
    drawAccessPoints();

    if (currentRoute) {
        drawRouteOverlay(currentRoute);
    }

    if (highlightedProduct) {
        drawProductHighlight(highlightedProduct);
    }

    drawCartMarkers();

    if (valid(cartPosition)) {
        marker(
            cartPosition.x,
            cartPosition.y,
            "#1565c0",
            "X",
            11
        );
    }
}


// =====================================================
// 25. HIEN THI LO TRINH
// =====================================================

export function drawRoute(points) {
    const good = Array.isArray(points)
        ? points
            .filter(valid)
            .map(p => ({
                x: Number(p.x),
                y: Number(p.y)
            }))
        : [];

    currentRoute = good.length >= 2
        ? good
        : null;

    if (!currentRoute) {
        console.warn(
            "Route khong hop le:",
            points
        );
    }

    drawSupermarketMap();
}


