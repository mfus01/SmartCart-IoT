function valid(point) {
    return point != null
        && point.x != null
        && point.y != null
        && Number.isFinite(Number(point.x))
        && Number.isFinite(Number(point.y))
        && Number(point.x) >= 0
        && Number(point.x) <= MAP_WIDTH
        && Number(point.y) >= 0
        && Number(point.y) <= MAP_HEIGHT;
}


// =====================================================
// 10. HAM VE CO BAN
// =====================================================

function rect(x, y, w, h, color) {
    ctx.fillStyle = color;
    ctx.fillRect(px(x), py(y), pw(w), ph(h));
}

function border(x, y, w, h, color = "#607d8b", line = 1.8) {
    ctx.strokeStyle = color;
    ctx.lineWidth = line;
    ctx.strokeRect(px(x), py(y), pw(w), ph(h));
}

function textCenter(
    label,
    x,
    y,
    size = 15,
    color = "#263238",
    maxWidth = undefined
) {
    ctx.fillStyle = color;
    ctx.font = `bold ${size}px Arial, sans-serif`;
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    ctx.fillText(
        String(label),
        px(x),
        py(y),
        maxWidth
    );
}

function marker(x, y, color, label, radius = 10) {
    ctx.beginPath();

    ctx.arc(
        px(x),
        py(y),
        radius,
        0,
        Math.PI * 2
    );

    ctx.fillStyle = color;
    ctx.fill();

    ctx.strokeStyle = "#ffffff";
    ctx.lineWidth = 2;
    ctx.stroke();

    ctx.fillStyle = "#ffffff";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    ctx.font = `bold ${
        label && String(label).length > 1 ? 11 : 13
    }px Arial`;

    ctx.fillText(
        String(label),
        px(x),
        py(y)
    );
}


// =====================================================
// 11. VE NEN SIEU THI
// =====================================================

function drawBackground() {
    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    rect(
        0, 0,
        MAP_WIDTH, MAP_HEIGHT,
        "#f5f9fa"
    );

    // Luoi 5 cm
    ctx.strokeStyle = "#e1ebec";
    ctx.lineWidth = 1;

    for (let x = 0; x <= 80; x += 5) {
        ctx.beginPath();
        ctx.moveTo(px(x), 0);
        ctx.lineTo(px(x), canvas.height);
        ctx.stroke();
    }

    for (let y = 0; y <= 120; y += 5) {
        ctx.beginPath();
        ctx.moveTo(0, py(y));
        ctx.lineTo(canvas.width, py(y));
        ctx.stroke();
    }

    // Ve tuong bao
    ctx.strokeStyle = "#34546c";
    ctx.lineWidth = 11;

    ctx.beginPath();

    ctx.moveTo(px(0.6), py(119.4));
    ctx.lineTo(px(0.6), py(0.6));
    ctx.lineTo(px(79.4), py(0.6));
    ctx.lineTo(px(79.4), py(119.4));

    ctx.lineTo(px(27), py(119.4));

    ctx.moveTo(px(7), py(119.4));
    ctx.lineTo(px(0.6), py(119.4));

    ctx.stroke();

    textCenter(
        "CUA VAO / RA 20 cm",
        17,
        118.1,
        13,
        "#27664a",
        180
    );
}


// =====================================================
// 12. VE CAC KHOI KE
