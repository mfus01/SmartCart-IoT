// =====================================================
// 18. TIM KE HANG
// =====================================================

function normalizeId(id) {
    let key = String(id ?? "")
        .trim()
        .toUpperCase();

    if (/^[A-H]$/.test(key)) {
        key += "1";
    }

    if (/^K[1-8]$/.test(key)) {
        const zone = String.fromCharCode(
            64 + Number(key.slice(1))
        );

        key = `${zone}2`;
    }

    if (
        key === "AM-THUC" ||
        key === "DELI"
    ) {
        key = "FOOD";
    }

    return key;
}

function findShelf(id) {
    const key = normalizeId(id);

    return key === "FOOD"
        ? DELI
        : shelves.find(s => s.id === key) || null;
}

function productPoint(product) {
    const shelf = findShelf(product?.shelfId);

    if (shelf) {
        return {
            shelf,
            x: shelf.accessX,
            y: shelf.accessY
        };
    }

    const fallback = {
        x: product?.xCoord,
        y: product?.yCoord
    };

    return valid(fallback)
        ? {
            shelf: null,
            x: Number(fallback.x),
            y: Number(fallback.y)
        }
        : null;
}


// =====================================================
// 19. HIGHLIGHT SAN PHAM
// =====================================================

function drawProductHighlight(product) {
    const loc = productPoint(product);

    if (!loc) return;

    ctx.strokeStyle = "#fb8c00";
    ctx.lineWidth = 4;

    if (loc.shelf) {
        border(
            loc.shelf.x,
            loc.shelf.y,
            loc.shelf.width,
            loc.shelf.height,
            "#fb8c00",
            4
        );
    }

    ctx.beginPath();

    ctx.arc(
        px(loc.x),
        py(loc.y),
        13,
        0,
        Math.PI * 2
    );

    ctx.stroke();

    const label = String(
        product.name || "San pham"
    );

    ctx.font = "bold 14px Arial";

    const w = Math.min(
        265,
        ctx.measureText(label).width + 20
    );

    const x = Math.max(
        7,
        Math.min(
            px(loc.x) + 13,
            canvas.width - w - 7
        )
    );

    const y = Math.max(
        8,
        py(loc.y) - 41
    );

    ctx.fillStyle = "#fff8e1";
    ctx.fillRect(x, y, w, 30);

    ctx.strokeStyle = "#ff9800";
    ctx.lineWidth = 1;
    ctx.strokeRect(x, y, w, 30);

    ctx.fillStyle = "#943a10";
    ctx.textAlign = "left";
    ctx.textBaseline = "middle";

    ctx.fillText(
        label,
        x + 8,
        y + 15,
        w - 14
    );
}


// =====================================================
// 20. VE TUYEN DUONG
// =====================================================

function drawRouteOverlay(points) {
    if (
        !Array.isArray(points) ||
        points.length < 2
    ) {
        return;
    }

    ctx.save();
    ctx.beginPath();

    points.forEach((p, i) => {
        if (i === 0) {
            ctx.moveTo(
                px(p.x),
                py(p.y)
            );
        } else {
            ctx.lineTo(
                px(p.x),
                py(p.y)
            );
        }
    });

    ctx.strokeStyle = "#8e24aa";
    ctx.lineWidth = 5;
    ctx.lineJoin = "round";
    ctx.lineCap = "round";

    ctx.setLineDash([12, 8]);
    ctx.stroke();
    ctx.restore();

    marker(
        points[0].x,
        points[0].y,
        "#2e7d32",
        "S",
        10
    );

    const last = points[points.length - 1];

    marker(
        last.x,
        last.y,
        "#c62828",
        "F",
        10
    );
}


// =====================================================
// 21. NHOM SAN PHAM TRONG GIO THEO KE
// =====================================================

function getCartShelfGroups() {
    const groups = [];
    const byShelf = new Map();

    cartProductsOnMap.forEach(product => {
        if (!product || !product.name) {
            return;
        }

        const loc = productPoint(product);

        if (!loc) return;

        const key = loc.shelf
            ? loc.shelf.id
            : `${loc.x}:${loc.y}`;

        if (!byShelf.has(key)) {
            const group = {
                index: groups.length + 1,
                shelf: loc.shelf,
                x: loc.x,
                y: loc.y,
                products: []
            };

            byShelf.set(key, group);
            groups.push(group);
        }

        byShelf.get(key).products.push(product);
    });

    return groups;
}


// =====================================================
// 22. DANH DAU TAT CA SAN PHAM TRONG GIO
// =====================================================

function drawCartMarkers() {
    getCartShelfGroups().forEach(group => {
        if (group.shelf) {
            border(
                group.shelf.x,
                group.shelf.y,
                group.shelf.width,
                group.shelf.height,
                "#ff9800",
                4
            );
        }

        marker(
            group.x,
            group.y,
            "#ef6c00",
            group.index,
            11
        );
    });
}


// =====================================================
// 23. DANH SACH KE CAN GHE
// =====================================================

function updateCartMapLegend() {
    let legend = document.getElementById(
        "cartMapLegend"
    );

    if (!legend) {
        legend = document.createElement("div");
        legend.id = "cartMapLegend";

        legend.style.cssText =
            "width:100%;max-width:560px;margin-top:8px;padding:10px;" +
            "background:#fff8e1;border:1px solid #ffcc80;border-radius:8px;" +
            "max-height:150px;overflow-y:auto;font:13px Arial,sans-serif;";

        canvas.insertAdjacentElement(
            "afterend",
            legend
        );
    }

    legend.replaceChildren();

    const groups = getCartShelfGroups();

    legend.style.display = groups.length
        ? "block"
        : "none";

    if (!groups.length) {
        return;
    }

    const header = document.createElement("strong");

    header.textContent =
        `🛒 Cac vi tri can ghe (${groups.length})`;

    legend.appendChild(header);

    groups.forEach(group => {
        const row = document.createElement("div");

        row.style.cssText =
            "margin-top:7px;line-height:1.4;";

        const name = group.shelf
            ? (
                group.shelf.physicalShelfId
                    ? `${group.shelf.physicalShelfId} - ${group.shelf.id}`
                    : "QUAY AM THUC"
            )
            : `(${group.x}, ${group.y})`;

        const products = group.products
            .map(p =>
                `${p.name} (x${Number(p.quantity) || 1})`
            )
            .join(", ");

        row.textContent =
            `${group.index}. ${name}: ${products}`;

        legend.appendChild(row);
    });
}


