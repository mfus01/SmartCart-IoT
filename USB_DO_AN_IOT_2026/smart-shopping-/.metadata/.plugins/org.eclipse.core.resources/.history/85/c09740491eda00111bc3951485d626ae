// ======================================================
// 10. HIEN THI KET QUA TIM KIEM TU DATABASE
// ======================================================

function displayDatabaseProducts(
    products,
    loadingMessage
) {

    if (
        !Array.isArray(products) ||
        products.length === 0
    ) {

        return;
    }

    loadingMessage.textContent =
        "✅ Đã tìm thấy "
        + products.length
        + " sản phẩm phù hợp trong siêu thị:";

    

    // Tao tung the san pham
    products.forEach(product => {

        addProductResultMessage(product);
    });

    scrollChatToBottom();
}


// ======================================================
// 11. XU LY KET QUA CHATBOT
// ======================================================

async function handleGeminiAdvice(message) {

    const loadingMessage = addChatMessage(
        "⏳ Đang xử lý yêu cầu...",
        "bot"
    );

    try {

        const result = await askGemini(message);

        // ==========================================
        // TRUONG HOP 1: GOI Y MON AN
        // ==========================================

        if (result.type === "recipe") {

            displayRecipeResult(
                result,
                loadingMessage
            );

            return;
        }

        // ==========================================
        // TRUONG HOP 2: TIM THAY SAN PHAM DATABASE
        // ==========================================

        if (
            Array.isArray(result.products) &&
            result.products.length > 0
        ) {

            displayDatabaseProducts(
                result.products,
                loadingMessage
            );

            return;
        }

        // ==========================================
        // TRUONG HOP 3: CHAT THONG THUONG
        // ==========================================

        loadingMessage.textContent =
            result.reply ||
            "Chưa có câu trả lời.";

    } catch (error) {

        console.error(
            "[CHAT ERROR]",
            error
        );

        loadingMessage.textContent =
            "⚠️ " + error.message;
    }

    scrollChatToBottom();
}


// ======================================================
// 12. TIM SAN PHAM
// ======================================================

async function handleSearchProduct(keyword) {

    clearPreviousSearchResults();

    try {

        // Tim truc tiep qua Product API
        const result =
            await searchProducts(keyword);

        const products =
            result &&
            result.success &&
            Array.isArray(result.data)
                ? result.data
                : [];

        if (products.length > 0) {

            const message = addChatMessage(
                "",
                "bot"
            );

            displayDatabaseProducts(
                products,
                message
            );

            return;
        }

    } catch (error) {

        console.warn(
            "Product API khong tim thay:",
            error
        );
    }

    // Neu khong tim thay bang Product API
    // thi gui yeu cau den GeminiController
    // Backend se tu tim database hoac goi AI

    await handleGeminiAdvice(keyword);
}


// ======================================================
// 13. GUI TIN NHAN
// ======================================================

async function handleSendMessage() {

    if (
        !chatInput ||
        !sendButton ||
        !chatMessages
    ) {

        console.error(
            "Khong tim thay giao dien chatbot."
        );

        return;
    }

    const keyword = chatInput.value.trim();

    if (
        keyword === "" ||
        sendButton.disabled
    ) {

        return;
    }

    // Hien thi cau hoi
    addChatMessage(
        keyword,
        "user"
    );

    // Xoa o nhap
    chatInput.value = "";

    // Khoa nut khi dang xu ly
    sendButton.disabled = true;

    const originalButtonText =
        sendButton.textContent;

    sendButton.textContent =
        "Đang xử lý...";

    try {

        await handleSearchProduct(keyword);

    } catch (error) {

        console.error(
            "Loi gui tin nhan:",
            error
        );

        addChatMessage(
            "Không thể xử lý yêu cầu.",
            "bot"
        );

    } finally {

        sendButton.disabled = false;

        sendButton.textContent =
            originalButtonText;

        chatInput.focus();
    }
}


// ======================================================
// 14. XU LY PHIM ENTER
// ======================================================

function handleInputKeydown(event) {

    if (
        event.key === "Enter" &&
        !event.isComposing
    ) {

        event.preventDefault();

        handleSendMessage();
    }
}


// ======================================================
// 15. KHOI DONG CHATBOT
// ======================================================

export function initChat() {

    if (
        !chatInput ||
        !sendButton ||
        !chatMessages
    ) {

        console.error(
            "Khong the khoi dong chatbot."
        );

        return;
    }

    sendButton.removeEventListener(
        "click",
        handleSendMessage
    );

    chatInput.removeEventListener(
        "keydown",
        handleInputKeydown
    );

    sendButton.addEventListener(
        "click",
        handleSendMessage
    );

    chatInput.addEventListener(
        "keydown",
        handleInputKeydown
    );

    console.log(
        "[CHAT] Chatbot da san sang."
    );
}

